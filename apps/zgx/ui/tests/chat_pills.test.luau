test("Escape closes a card first: the agent keeps running", function()
	local app = opened()
	app:command("start_reply")
	app:set_state("test_subs", { sub("a", "running") })
	pop(app)
	app:click('#chat-composer >> role:textbox "Message"')
	app:frames(5)
	app:click("#pills-agents")
	pop(app)
	expect(app:has("#pills-roster")).to_be(true)
	app:key("Escape")
	gone(app)
	expect(app:has("#pills-roster")).to_be(false)
	expect(string.find(app:state("calls"), "interrupt", 1, true)).to_be(nil)
	-- Focus moved off the card to the composer (⌘L): its Escape still closes the card first.
	app:click("#pills-agents")
	pop(app)
	app:command("escape_from_composer")
	gone(app)
	expect(app:has("#pills-roster")).to_be(false)
	expect(string.find(app:state("calls"), "interrupt", 1, true)).to_be(nil)
	expect(app:error()).to_be(nil)
end)

local function asking(chat: string, title: string): any
	return {
		key = `{chat}:r1`,
		chat = chat,
		request = "r1",
		title = title,
		kind = "ask",
		steps = {},
		ask = {
			request = "r1",
			kind = "question",
			question = { header = "Branch", text = `Where, {title}?`, multi = false, page = 1, pages = 2, options = { { value = "main", label = "main" }, { value = "dev", label = "dev" } } },
		},
	}
end

