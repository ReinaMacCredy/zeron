test("a parent stays with its nested rows, up top if any of them works", function()
	local app = opened()
	app:set_state("test_subs", { sub("done", "done"), sub("parent", "done"), sub("alive", "running") })
	app:set_state("test_usage", { ["doc-parent"] = { spawns = { { ref = "doc-kid", call = "kid", title = "Agent kid", status = "running" } } } })
	pop(app)
	app:click("#pills-agents")
	pop(app, 40)
	local rows = app:tree("#pills-roster")
	local at = function(words: string): number
		return (string.find(rows, words, 1, true) :: number)
	end
	expect(at("Agent parent") < at("Agent kid")).to_be(true)
	expect(at("Agent kid") < at("Previous agents")).to_be(true)
	expect(at("Previous agents") < at("Agent done")).to_be(true)
	expect(app:error()).to_be(nil)
end)

