test("a pill coming or going moves neither the composer nor the room under the transcript", function()
	local app = opened()
	local before = box(app, "#chat-composer")
	local room = app:state("chat_dock_h")
	app:set_state("test_subs", { sub("a", "running") })
	pop(app, 30)
	local during = box(app, "#chat-composer")
	expect(during.y).to_be(before.y)
	expect(during.h).to_be(before.h)
	expect(app:state("chat_dock_h")).to_be(room)
	local row = box(app, "#composer-pills")
	expect(row.y + row.h <= before.y).to_be(true)
	app:set_state("test_subs", {})
	pop(app, 30)
	expect(box(app, "#chat-composer").y).to_be(before.y)
	expect(app:error()).to_be(nil)
end)

test("Stop on one row stops that row alone: a spawn by its call, a delegate by TaskCancel, none where the harness can't", function()
	local app = opened()
	app:set_state("test_session_patch", { harness = "claude-code" })
	app:command("patch_session")
	app:set_state("test_subs", { sub("a", "running"), sub("b", "running") })
	app:set_state("test_children", { s2 = { { id = "kid", parent = "s2", title = "Delegated", status = "working", delegation = "running", created = os.time(), delegated_at = os.time() } } })
	pop(app)
	app:click("#pills-agents")
	pop(app)
	app:click('role:button "Stop Agent a"')
	app:frames(5)
	expect(app:state("calls")).to_contain("stop_task:s2:a")
	expect(string.find(app:state("calls"), "stop_task:s2:b", 1, true)).to_be(nil)
	expect(string.find(app:state("calls"), "interrupt", 1, true)).to_be(nil)
	app:click('role:button "Stop Delegated"')
	app:frames(5)
	expect(app:state("calls")).to_contain("cancel_delegate:s2:kid")
	expect(app:error()).to_be(nil)
end)

