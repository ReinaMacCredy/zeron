local function shell_tasks(app: any, stoppable: boolean?)
	app:set_state("test_session_patch", {
		tasks = {
			{ id = "ag", kind = "process", task_kind = "agent", name = "Helper", since = os.time() - 5 },
			{ id = "sh", kind = "process", task_kind = "shell", name = "npm test", since = os.time() - 5 },
			{ id = "old", kind = "process", name = "npm run dev", since = os.time() - 5 },
		},
		shells_stoppable = stoppable,
	})
	app:command("patch_session")
	pop(app)
end

