local function box(app: any, sel: string): any
	local line = string.match(app:tree(sel), "[^\n]+") or ""
	local x, y, w, h = string.match(line, "(-?[%d.]+),(-?[%d.]+) ([%d.]+)x([%d.]+)")
	return { x = tonumber(x), y = tonumber(y), w = tonumber(w), h = tonumber(h) }
end

local function opened(): any
	local app = mount("chat_fixture.luau")
	app:resize(1100, 800)
	app:command("go_s2")
	app:frames(30)
	return app
end

local function sub(id: string, status: string, fields: { [string]: any }?): any
	local row = { ref = `doc-{id}`, call = id, title = `Agent {id}`, status = status, recent = true, at = os.time() - 5 }
	for k, v in fields or {} do
		row[k] = v
	end
	return row
end

local function pop(app: any, n: number?)
	app:frames(n or 20)
end

-- A card's exit runs on the wall clock, which a test's frames outrun.
local function gone(app: any)
	app:wait("#never-shown", { timeout_ms = 400 })
	app:frames(10)
end

test("one run names itself; several say how many work and how many are done", function()
	local app = opened()
	expect(app:has("#pills-agents")).to_be(false)
	app:set_state("test_subs", { sub("a", "running") })
	pop(app)
	expect(app:has('#pills-agents >> ~"Agent a"')).to_be(true)
	expect(app:text("#pills-agents-words")).to_contain("· Working")
	app:set_state("test_subs", { sub("a", "running"), sub("b", "running"), sub("c", "done") })
	pop(app)
	expect(app:text("#pills-agents-words")).to_contain("2 Working")
	expect(app:text("#pills-agents-done")).to_contain("1 Done")
	expect(app:error()).to_be(nil)
end)

