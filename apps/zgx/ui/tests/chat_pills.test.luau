	pop(app, 30)
	expect(string.match(app:tree("#test-fan"), "@%d+")).to_be(before)
	expect(app:tree("#test-fan")).to_contain("2 agents")
	app:set_state("test_subs", { sub("a", "running") })
	pop(app, 30)
	expect(string.match(app:tree("#test-fan"), "@%d+")).to_be(before)
	expect(app:error()).to_be(nil)
end)

test("a press outside a card leaves the keyboard where the press put it", function()
	local app = opened()
	app:set_state("test_waiting", { asking("other", "Other chat") })
	pop(app)
	local field = '#chat-composer >> role:textbox "Message"'
	app:click("#pills-waiting")
	pop(app)
	app:click("#fixture-drag-section")
	gone(app)
	expect(app:has("#pills-waiting-card")).to_be(false)
	expect(app:tree(field)).never.to_contain("focused")
	expect(app:error()).to_be(nil)
end)
