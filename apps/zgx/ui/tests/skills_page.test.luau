-- The Skills page (screens/skills) on ui/skills_fixture.luau, its host answered there: the rail opens it, every agent's
-- skills as cards, an agent's alone by its filter, a skill's dialog with its SKILL.md, the switch for `$`, Uninstall
-- and Try now, Escape closing one layer at a time.

local DISABLED = "screens/chat/invocations.luau::skills_disabled"

local function open(): any
	local app = mount("skills_fixture.luau")
	app:resize(1200, 900)
	app:frames(20)
	app:click("#rail-skills")
	app:frames(20)
	return app
end

local function card(app: any, name: string)
	app:click(`#skills-card-{name}`)
	app:frames(20)
end

test("Skills: the rail opens every agent's skills, a card each; an agent's filter narrows them and names the page", function()
	local app = open()
	expect(app:state("shell_route_path")).to_be("/plugin/zeron/skills")
	expect(app:tree("#skills-title")).to_contain("All skills")
	expect(app:tree("#skills-subtitle")).to_contain("3 skills")
	expect(app:has("#skills-card-code-review")).to_be(true)
	expect(app:has("#skills-card-pdf")).to_be(true)
	expect(app:tree("#skills-tab-codex")).to_contain("Codex")
	expect(app:tree("#skills-tab-codex")).to_contain('"2"')
	expect(app:tree("#skills-tab-claude-code")).to_contain('"2"')
	app:click("#skills-tab-codex")
	app:frames(20)
	expect(app:tree("#skills-title")).to_contain("Codex")
	expect(app:tree("#skills-subtitle")).to_contain("2 skills")
	expect(app:has("#skills-card-pdf")).to_be(false)
	expect(app:has("#skills-card-native")).to_be(true)
	app:click("#skills-tab-all")
	app:frames(20)
	expect(app:has("#skills-card-pdf")).to_be(true)
	expect(app:state("skills_calls")).to_be("list")
end)

test("Skills: a list the host refuses says why; one asked again lists them", function()
	local app = mount("skills_fixture.luau")
	app:resize(1200, 900)
	app:frames(20)
	app:command("skills.refuse_next")
	app:click("#rail-skills")
	app:frames(20)
	expect(app:tree("#skills-subtitle")).to_contain("Could not load skills: refused")
	app:click("#rail-new-chat")
	app:frames(20)
	app:click("#rail-skills")
	app:frames(20)
	expect(app:tree("#skills-subtitle")).to_contain("3 skills")
end)

test("Skills: a card's dialog reads its SKILL.md past its front matter, names its agents and folder; Escape closes the menu, then the question, then the dialog", function()
	local app = open()
	card(app, "code-review")
	expect(app:has("#skill-dialog")).to_be(true)
	expect(app:state("skills_calls")).to_contain("read:/home/ada/.agents/skills/code-review/SKILL.md")
	expect(app:tree("#skill-doc")).to_contain("Read the whole diff first.")
	expect(app:tree("#skill-doc")).never.to_contain("description:")
	expect(app:tree("#skill-dialog")).to_contain("~/.agents/skills/code-review")
	expect(app:tree("#skill-dialog")).to_contain("Claude Code")
	expect(app:tree("#skill-dialog")).to_contain("Codex")
	app:click("#skill-dialog-more")
	app:frames(20)
	expect(app:has("#skill-menu-reveal")).to_be(true)
	app:key("Escape")
	app:frames(20)
	expect(app:state("skills_menu")).to_be(false)
	expect(app:has("#skill-dialog")).to_be(true)
	app:click("#skill-uninstall")
	app:frames(20)
	expect(app:has("#skill-uninstall-confirm")).to_be(true)
	app:key("Escape")
	app:frames(20)
	expect(app:has("#skill-uninstall-confirm")).to_be(false)
	expect(app:has("#skill-dialog")).to_be(true)
	app:key("Escape")
	app:frames(30)
	expect(app:has("#skill-dialog")).to_be(false)
	expect(app:state("skills_calls")).never.to_contain("trash")
end)

test("Skills: the harness's own skill has no SKILL.md, no menu and no Uninstall; Reveal and Open ask the host", function()
	local app = open()
	card(app, "native")
	expect(app:tree("#skill-doc")).to_contain("comes from the harness")
	expect(app:has("#skill-dialog-more")).to_be(false)
	expect(app:has("#skill-uninstall")).to_be(false)
	app:key("Escape")
	app:frames(30)
	app:command("skills.refuse_next")
	card(app, "pdf")
	expect(app:tree("#skill-doc")).to_contain("Could not read SKILL.md: refused")
	app:key("Escape")
	app:frames(30)
	card(app, "pdf")
	app:click("#skill-dialog-more")
	app:frames(20)
	app:click("#skill-menu-open")
	app:frames(10)
	expect(app:state("skills_calls")).to_contain("open:/home/ada/.claude/skills/pdf/SKILL.md")
	app:click("#skill-dialog-more")
	app:frames(20)
	app:click("#skill-menu-reveal")
	app:frames(10)
	expect(app:state("skills_calls")).to_contain("reveal:/home/ada/.claude/skills/pdf/SKILL.md")
	app:click("#skill-dialog-more")
	app:frames(20)
	app:click("#skill-menu-copy")
	app:frames(10)
	expect(app:has('"Copied SKILL.md"')).to_be(true)
end)

test("Skills: Use this skill turns every copy off for `$` and on again", function()
	local app = open()
	card(app, "code-review")
	app:click("#skill-dialog-toggle >> role:switch")
	app:frames(10)
	local off = app:state(DISABLED)
	expect(off["/home/ada/.agents/skills/code-review/SKILL.md"]).to_be(true)
	expect(off["/home/ada/.codex/skills/code-review/SKILL.md"]).to_be(true)
	app:click("#skill-dialog-toggle >> role:switch")
	app:frames(10)
	expect(next(app:state(DISABLED))).to_be(nil)
end)

test("Skills: Move to Trash takes every copy and the card; a refusal says so and keeps it", function()
	local app = open()
	card(app, "pdf")
	app:command("skills.refuse_next")
	app:click("#skill-uninstall")
	app:frames(10)
	app:click("#skill-uninstall-confirm")
	app:frames(20)
	expect(app:has('~"Could not move the skill to the Trash: refused"')).to_be(true)
	expect(app:has("#skill-dialog")).to_be(true)
	app:click("#skill-uninstall-confirm")
	app:frames(30)
	expect(app:state("skills_calls")).to_contain("trash:/home/ada/.claude/skills/pdf/SKILL.md")
	expect(app:has("#skill-dialog")).to_be(false)
	expect(app:has("#skills-card-pdf")).to_be(false)
	expect(app:tree("#skills-subtitle")).to_contain("2 skills")
	card(app, "code-review")
	app:click("#skill-uninstall")
	app:frames(10)
	app:click("#skill-uninstall-confirm")
	app:frames(30)
	app:click("#skills-tab-claude-code")
	app:frames(20)
	expect(app:has("#skills-none")).to_be(true)
	expect(app:tree("#skills-subtitle")).to_contain("0 skills")
end)

test("Skills: Try now starts a new chat on an agent that has it, the one shown first, the skill at the draft's head", function()
	local app = open()
	app:click("#skills-tab-codex")
	app:frames(20)
	card(app, "code-review")
	app:click("#skill-try-now")
	app:frames(30)
	expect(app:state("shell_route_path")).to_be("/")
	expect(app:has("#skill-dialog")).to_be(false)
	expect(app:state("chat.composer.text")).to_be("$code-review ")
	expect(app:state("chat_model")).to_be("gpt-5.5")
end)
