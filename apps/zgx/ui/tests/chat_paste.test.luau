-- A long paste as a chip, the viewer of one sent, a failed send handing
-- everything back, and the one badge for review comments
-- (ui/paste_fixture.luau, the host's file calls stubbed).

local function open(chat: string?): any
	local app = mount("paste_fixture.luau")
	app:resize(900, 700)
	app:command(`go_{chat or "s2"}`)
	app:frames(30)
	return app
end

local function cargo(app: any): { any }
	return app:state("chat.composer.cargo") or {}
end

local function paste(app: any, count: number, unit: string?): string
	app:set_state("test_paste_length", count)
	app:set_state("test_paste_unit", unit or "a")
	app:command("paste_now")
	app:frames(2)
	return app:state("test_paste_answer")
end

local function paste_words(app: any, text: string): string
	app:set_state("test_paste_length", 0)
	app:set_state("test_paste_words", text)
	app:command("paste_now")
	app:frames(2)
	return app:state("test_paste_answer")
end

test("paste threshold: 4,999 characters stay words, 5,000 are a chip, counted in characters not bytes", function()
	local app = open()
	expect(paste(app, 4999)).to_be("false")
	expect(#cargo(app)).to_be(0)
	expect(paste(app, 5000)).to_be("true")
	expect(#cargo(app)).to_be(1)
	-- Two bytes each: 9,998 bytes is still under the threshold.
	expect(paste(app, 4999, "é")).to_be("false")
	expect(#cargo(app)).to_be(1)
	expect(paste(app, 5000, "é")).to_be("true")
	expect(#cargo(app)).to_be(2)
	expect(app:error()).to_be_nil()
end)

test("paste threshold: the draft leading with a command, or a canonical chip in the text, keeps it words", function()
	local app = open()
	local long = string.rep("a", 6000)
	app:set_state("chat.composer.text", "/review ")
	expect(paste_words(app, long)).to_be("false")
	app:set_state("chat.composer.text", "$code-review ")
	expect(paste_words(app, long)).to_be("false")
	-- Four spaces of indent is code, not a command.
	app:set_state("chat.composer.text", "    /review ")
	expect(paste_words(app, long)).to_be("true")
	app:set_state("chat.composer.text", "")
	expect(paste_words(app, long .. " [Image 1](zeron-image:1)")).to_be("false")
	expect(paste_words(app, long .. " [a.txt](zeron-attachment:3)")).to_be("false")
	-- Another chip's link isn't an attachment's.
	expect(paste_words(app, long .. " [x](zeron-chat:12)")).to_be("true")
	expect(app:error()).to_be_nil()
end)

test("paste: an old host leaves the text to land as words, and burns no number", function()
	local app = open()
	app:set_state("test_host", "old")
	expect(paste(app, 6000)).to_be("false")
	expect(#cargo(app)).to_be(0)
	app:set_state("test_host", "new")
	expect(paste(app, 6000)).to_be("true")
	expect(cargo(app)[1].name).to_be("Pasted text 1.txt")
end)

test("paste: over 24 MiB is refused in one line with nothing staged; a failed write leaves the text in the draft", function()
	local app = open()
	-- (At the limit it's a chip: searching it stays inside a call's budget.)
	expect(paste(app, 24 * 1024 * 1024)).to_be("true")
	expect(#cargo(app)).to_be(1)
	app:command("remove_first_pasted")
	app:frames(2)
	expect(paste(app, 24 * 1024 * 1024 + 1)).to_be("true")
	expect(#cargo(app)).to_be(0)
	expect(app:state("chat.composer.refused")).to_be("The pasted text is too large (24 MB max).")
	app:set_state("test_host", "write_fails")
	expect(paste(app, 5000)).to_be("true")
	expect(#cargo(app)).to_be(0)
	expect(#app:state("chat.composer.text")).to_be(5000)
	-- The next attach cleared the refusal.
	expect(app:state("chat.composer.refused")).to_be_nil()
end)

test("paste: a chip is a file named by a number never reused in its draft, a send starting over", function()
	local app = open()
	paste(app, 5000)
	paste(app, 5000)
	expect(cargo(app)[2].name).to_be("Pasted text 2.txt")
	expect(cargo(app)[2].kind).to_be("file")
	expect(cargo(app)[2].pasted).to_be(true)
	app:command("remove_first_pasted")
	app:command("remove_first_pasted")
	app:frames(2)
	paste(app, 5000)
	expect(cargo(app)[1].name).to_be("Pasted text 3.txt")
	app:command("take_now")
	app:frames(2)
	paste(app, 5000)
	expect(cargo(app)[1].name).to_be("Pasted text 1.txt")
end)

test("paste: the chip stands in the words at the caret, its first line, and goes as gpui's link with its file; deleted, the file stays", function()
	local app = open()
	app:set_state("chat.composer.text", "see ")
	paste_words(app, "# Spec: Uploader service design\n" .. string.rep("x", 5000))
	local draft = app:state("chat.composer.text")
	expect(string.sub(draft, 1, 4)).to_be("see ")
	expect(string.find(draft, "Spec:\u{a0}Uploader\u{a0}ser…", 1, true) ~= nil).to_be(true)
	app:command("take_now")
	app:frames(2)
	local taken = app:state("test_taken")
	expect(taken.text).to_be("see [Pasted text 1.txt](zeron-attachment:1)")
	expect(taken.names[1]).to_be("Pasted text 1.txt")
	paste_words(app, string.rep("y", 5000))
	app:set_state("chat.composer.text", "no chip")
	app:command("take_now")
	app:frames(2)
	taken = app:state("test_taken")
	expect(taken.text).to_be("no chip")
	expect(#taken.names).to_be(0)
	expect(app:error()).to_be_nil()
end)

test("paste label: the first line with anything on it, cut at 20 characters as a person counts them", function()
	local app = open()
	local function label(text: string): string
		app:set_state("test_paste_words", text)
		app:command("label_now")
		return app:state("test_paste_label")
	end
	expect(label("\n  \n# Spec: Uploader service design\nmore")).to_be("# Spec: Uploader ser…")
	expect(label(string.rep("a", 20))).to_be(string.rep("a", 20))
	expect(label(string.rep("a", 21))).to_be(string.rep("a", 20) .. "…")
	-- Combining marks (a decomposed ệ) and emoji with a skin tone are one each.
	local e = "e\204\130\204\163"
	expect(label(string.rep(e, 20))).to_be(string.rep(e, 20))
	expect(label(string.rep(e, 21))).to_be(string.rep(e, 20) .. "…")
	local wave = "\240\159\145\139\240\159\143\189"
	expect(label(string.rep(wave, 21))).to_be(string.rep(wave, 20) .. "…")
	-- Nothing visible in the first 4 KiB: no label.
	expect(label(string.rep(" \n", 2048) .. "late")).to_be("<none>")
	-- A multibyte character cut by the 4 KiB limit doesn't break it.
	expect(label(string.rep("é", 3000))).to_be(string.rep("é", 20) .. "…")
end)

test("a pasted chip pressed puts its text back and goes, once however often it's pressed; unreadable it stays", function()
	local app = open()
	paste_words(app, string.rep("b", 5000))
	app:set_state("chat.composer.text", "before ")
	app:command("open_first_pasted")
	app:frames(2)
	expect(#cargo(app)).to_be(0)
	expect(#app:state("chat.composer.text")).to_be(5007)
	expect(string.sub(app:state("chat.composer.text"), 1, 8)).to_be("before b")
	-- Pressed twice before the host answers: its text once.
	app:set_state("chat.composer.text", "")
	app:set_state("test_read_late", true)
	paste_words(app, string.rep("b", 5000))
	app:command("open_first_pasted")
	app:command("answer_reads")
	app:frames(2)
	expect(#app:state("chat.composer.text")).to_be(5000)
	app:set_state("test_read_late", false)
	app:set_state("chat.composer.text", "before ")
	paste_words(app, string.rep("c", 5000))
	-- (Its chip gone from the draft: the words land at the caret.)
	app:set_state("chat.composer.text", "before ")
	app:command("open_pasted_at_caret")
	app:frames(2)
	expect(app:state("test_chip")).to_be("caret:5000")
	expect(#app:state("chat.composer.text")).to_be(7)
	expect(#cargo(app)).to_be(0)
	paste_words(app, string.rep("d", 5000))
	app:set_state("test_read_fails", true)
	app:command("open_first_pasted")
	app:frames(2)
	expect(#cargo(app)).to_be(1)
	expect(app:state("chat.composer.refused")).to_be("Pasted text 4.txt could not be read.")
end)

test("restore: a failed send puts the words and every chip back, merged by id with what was staged since", function()
	local app = open()
	app:set_state("chat.composer.text", "my words")
	app:command("add_to_chat")
	paste(app, 5000)
	app:command("leave_comments")
	app:frames(5)
	local before = #cargo(app)
	expect(before >= 4).to_be(true)
	local ids: { string } = {}
	for _, item in cargo(app) do
		table.insert(ids, item.id)
	end
	app:command("take_now")
	app:frames(2)
	expect(#cargo(app)).to_be(0)
	expect(app:state("chat.composer.text")).to_be("")
	app:command("stage_more")
	app:set_state("chat.composer.text", "typed since")
	app:frames(2)
	app:command("restore_now")
	app:frames(2)
	local after = cargo(app)
	expect(#after).to_be(before + 1)
	for i, id in ids do
		expect(after[i].id).to_be(id)
	end
	expect(after[#after].name).to_be("later.rs")
	expect(app:state("chat.composer.text")).to_be("my words\n\ntyped since")
	-- Numbers carry on above what came back.
	paste(app, 5000)
	expect(cargo(app)[#cargo(app)].name).to_be("Pasted text 2.txt")
	-- Back twice is the same chips, by id.
	app:command("restore_now")
	app:frames(2)
	expect(#cargo(app)).to_be(before + 2)
end)

test("restore: on the chat it came from, not the one shown since", function()
	local app = open("s1")
	app:set_state("chat.composer.text", "for s1")
	paste(app, 5000)
	app:command("take_now")
	app:frames(2)
	app:command("go_s2")
	app:frames(30)
	app:command("restore_now")
	app:frames(2)
	expect(#cargo(app)).to_be(0)
	expect(app:state("chat.composer.text")).to_be("")
	app:command("draft_of_s1")
	expect(app:state("test_chip")).to_be("for s1|Pasted text 1.txt")
end)

test("a chat can't mention itself: it says so, and no chip", function()
	local app = open()
	app:command("mention_shown")
	expect(app:state("test_mention")).to_be("This is the open thread; it can't mention itself.")
	expect(#cargo(app)).to_be(0)
end)

test("comments badge: one with a count, its menu the rows, each removable, and Clear all", function()
	local app = open()
	app:command("leave_comments")
	app:frames(30)
	expect(app:has('#chat-composer >> role:button ~"2 comments"')).to_be(true)
	expect(app:has('#chat-composer >> "app.rs:12"')).to_be(false)
	app:click('#chat-composer >> role:button ~"2 comments"')
	app:frames(30)
	expect(app:has('"app.rs:12"')).to_be(true)
	expect(app:has('"guide.md:3"')).to_be(true)
	app:click('role:button "Remove comment Typo here."')
	app:frames(30)
	expect(app:has('"guide.md:3"')).to_be(false)
	expect(app:has('#chat-composer >> role:button ~"1 comment"')).to_be(true)
	expect(#cargo(app)).to_be(1)
	app:click('role:button "Clear all comments"')
	app:frames(30)
	expect(#cargo(app)).to_be(0)
	expect(app:has('"app.rs:12"')).to_be(false)
	expect(app:error()).to_be_nil()
end)

test("the wrap folds only past what a short window holds", function()
	local app = open()
	app:command("attach_9_files")
	app:frames(30)
	expect(app:has('role:button ~"more attachments"')).to_be(false)
	app:command("take_now")
	app:frames(30)
	app:command("attach_20_images")
	app:frames(30)
	expect(#cargo(app)).to_be(20)
	expect(app:has('role:button ~"more attachments"')).to_be(true)
	app:click('role:button ~"more attachments"')
	app:frames(30)
	expect(app:has('role:button "Show fewer attachments"')).to_be(true)
	expect(app:error()).to_be_nil()
end)

local function viewer(app: any): boolean
	return app:state("ds/pasted_text.luau::open") ~= nil
end

test("the viewer: its title and lines, closed by Escape and ×", function()
	local app = open()
	app:command("open_viewer")
	app:frames(10)
	expect(viewer(app)).to_be(true)
	expect(app:has('"Pasted text 2"')).to_be(true)
	expect(app:has('~"3 lines"')).to_be(true)
	expect(app:has('~"second"')).to_be(true)
	app:key("Escape")
	app:frames(60)
	expect(viewer(app)).to_be(false)
	app:command("open_viewer")
	app:frames(10)
	app:click('role:button "Close"')
	app:frames(60)
	expect(viewer(app)).to_be(false)
	app:set_state("test_read_fails", true)
	app:command("open_viewer")
	app:frames(10)
	expect(app:has('~"Couldn\'t load the pasted text"')).to_be(true)
	expect(app:error()).to_be_nil()
end)

test("the viewer's blocks: at most 50 lines or 8 KiB, a long line cut between characters", function()
	local app = open()
	local function decode(text: string): any
		app:set_state("test_decode_text", text)
		app:command("decode_now")
		return app:state("test_decoded")
	end
	local lines: { string } = {}
	for i = 1, 120 do
		table.insert(lines, `line {i}`)
	end
	local many = decode(table.concat(lines, "\n") .. "\n")
	expect(many.lines).to_be(120)
	expect(many.count).to_be(3)
	expect(select(2, string.gsub(many.first, "\n", ""))).to_be(49)
	expect(string.sub(many.last, -8)).to_be("line 120")
	-- (A byte ahead, so 8 KiB falls inside a character.)
	local long = decode("a" .. string.rep("é", 10000))
	expect(long.lines).to_be(1)
	expect(long.count).to_be(3)
	expect(long.most <= 8192).to_be(true)
	expect(long.valid).to_be(true)
	local crlf = decode("a\r\nb\r\n")
	expect(crlf.lines).to_be(2)
	expect(crlf.first).to_be("a\nb")
	expect(decode("").count).to_be(0)
	local function number(name: string): number
		app:set_state("test_number_of", name)
		app:command("number_now")
		return app:state("test_number")
	end
	expect(number("Pasted text 2.txt")).to_be(2)
	expect(number("ab12cd34-Pasted_text_12.txt")).to_be(12)
	expect(number("notes.txt")).to_be(0)
end)
