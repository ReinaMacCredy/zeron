local function settle(app: any)
	app:frames(30)
end

test("/config sent opens the settings panel in place of a turn, and Esc closes it", function()
	local app = mount("chat_fixture.luau")
	app:resize(1100, 800)
	app:command("go_s1")
	settle(app)
	app:type('role:textbox "Message"', "/config")
	app:key("Enter")
	settle(app)
	expect(app:wait("#claude-config", { timeout_ms = 1000 })).to_be(true)
	expect(app:text('role:textbox "Message"')).to_be("")
	local calls = app:state("calls")
	expect(calls).to_contain("config_open:s1:claude")
	expect(calls:find("send:s1", 1, true)).to_be(nil)
	expect(app:has('role:tab "Zeron"')).to_be(true)
	expect(app:has('~"Auto-compact"')).to_be(true)
	app:key("Escape")
	settle(app)
	expect(app:wait("#claude-config", { gone = true, timeout_ms = 1000 })).to_be(true)
	expect(app:state("calls")).to_contain("config_close")
	expect(app:error()).to_be(nil)
end)

test("the Zeron tab's Plan size row opens on the four sizes, and a new mission starts from the pick", function()
	local app = mount("chat_fixture.luau")
	app:resize(1100, 800)
	app:command("go_s1")
	app:command("offer_missions")
	settle(app)
	app:type('role:textbox "Message"', "/config")
	app:key("Enter")
	settle(app)
	expect(app:wait("#claude-config", { timeout_ms = 1000 })).to_be(true)
	app:click('role:tab "Zeron"')
	settle(app)
	expect(app:tree("#claude-config-zeron")).to_contain('listitem "Plan size"')
	app:key("Enter")
	settle(app)
	expect(app:has('~"up to 10 steps"')).to_be(true)
	expect(app:has('~"no limit"')).to_be(true)
	app:key("ArrowDown")
	app:key("Enter")
	settle(app)
	expect(app:has('~"up to 10 steps"')).to_be(false)
	expect(app:tree("#claude-config-value-mission.size")).to_contain("Large")
	app:key("Escape")
	settle(app)
	expect(app:wait("#claude-config", { gone = true, timeout_ms = 1000 })).to_be(true)
	app:click("#composer-mission")
	settle(app)
	expect(app:state("calls")).to_contain("configure:s1:mission=by_role/asks/large")
	expect(app:error()).to_be(nil)
end)
