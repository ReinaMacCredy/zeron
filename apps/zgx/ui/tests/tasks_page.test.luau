-- The Tasks page on ui/tasks_fixture.luau.

local function open(command: string?): any
	local app = mount("tasks_fixture.luau")
	app:resize(1200, 800)
	app:frames(30)
	if command then
		app:command(command)
		app:frames(5)
	end
	app:click("#rail-tasks")
	app:frames(30)
	return app
end
local function calls(app: any): string
	return app:state("tasks_calls") :: string
end
local function focused(app: any, target: string): boolean
	return (string.find((app:tree(target):match("[^\n]+")) or "", " focused")) ~= nil
end
local function rows(app: any): number
	local n = 0
	for l in app:tree("#tasks-list"):gmatch("[^\n]+") do
		if l:match("#task%-row%-") then
			n += 1
		end
	end
	return n
end

test("the rail opens Tasks: its title, how many are left, and a row for each open task", function()
	local app = open()
	expect(app:state("shell_route_path")).to_be("/plugin/zeron/tasks")
	expect(app:has('#tasks-page >> role:heading "Tasks"')).to_be(true)
	expect(app:tree("#tasks-subtitle")).to_contain("8 to do")
	expect(app:has("#task-row-t1")).to_be(true)
	expect(app:has("#task-row-t9")).to_be(false)
	expect(app:tree("#tasks-done-toggle")).to_contain("Done")
end)

test("each row says its one state: the thread's word, Not sent, Chat deleted, overdue, Blocked by", function()
	local app = open()
	expect(app:tree("#task-row-t1")).to_contain("Ship the release")
	expect(app:tree("#task-row-t1")).to_contain("Asked you a question")
	expect(app:tree("#task-row-t2")).to_contain("Working")
	expect(app:tree("#task-row-t6")).to_contain("Ready for you")
	expect(app:tree("#task-row-t7")).to_contain("Chat deleted")
	expect(app:tree("#task-row-t8")).to_contain("Not sent")
	expect(app:tree("#task-row-t8")).never.to_contain("Ready for you")
	expect(app:tree("#task-row-t3")).to_contain("due ")
	expect(app:tree("#task-row-t5")).to_contain("Blocked by")
	expect(app:tree("#task-row-t5")).to_contain("Port the sidebar fold")
	expect(app:has("#task-thumb-t2-1")).to_be(true)
end)

test("the add row: Enter saves at the top, Escape clears, Tab saves and opens the card on its notes", function()
	local app = open()
	app:type("#tasks-add", "Buy milk")
	app:key("Enter")
	app:frames(10)
	expect(calls(app)).to_contain("create:Buy milk")
	expect(app:tree("#tasks-subtitle")).to_contain("9 to do")
	app:type("#tasks-add", "Throw away")
	app:key("Escape")
	app:frames(5)
	expect(calls(app)).never.to_contain("Throw away")
	app:type("#tasks-add", "Plan the trip")
	app:key("Tab")
	app:frames(20)
	expect(calls(app)).to_contain("create:Plan the trip")
	expect(app:has("#task-card")).to_be(true)
	expect(focused(app, "#task-card-notes")).to_be(true)
end)

test("the check ticks a task done and back, and the Done group opens on its count", function()
	local app = open()
	app:click("#task-check-t4")
	app:frames(10)
	expect(calls(app)).to_contain("update:t4:completed=true")
	expect(app:has("#task-row-t4")).to_be(false)
	app:click("#tasks-done-toggle")
	app:frames(10)
	expect(app:has("#task-row-t4")).to_be(true)
	expect(app:has("#task-row-t9")).to_be(true)
	app:click("#task-check-t9")
	app:frames(10)
	expect(calls(app)).to_contain("update:t9:completed=false")
end)

test("keyboard all the way: arrows walk the rows, Enter opens the card, Escape closes it, Space ticks", function()
	local app = open()
	app:click("#tasks-subtitle")
	app:key("ArrowDown")
	app:key("ArrowDown")
	app:frames(5)
	app:key("Enter")
	app:frames(20)
	expect(app:has('#task-card >> role:textbox "Task title"')).to_be(true)
	expect(app:tree("#task-card")).to_contain("Port the sidebar fold")
	app:key("Escape")
	app:frames(20)
	expect(app:has("#task-card")).to_be(false)
	app:click("#tasks-subtitle")
	app:key("Space")
	app:frames(10)
	expect(calls(app)).to_contain("update:t2:completed=true")
end)

test("a click outside closes the card", function()
	local app = open()
	app:click("#task-row-t4")
	app:frames(20)
	expect(app:has("#task-card")).to_be(true)
	app:click("#task-card-backdrop")
	app:frames(20)
	expect(app:has("#task-card")).to_be(false)
end)

test("the card saves its title a pause after typing, sets the due day, and deletes from its menu", function()
	local app = open()
	app:click("#task-row-t4")
	app:frames(20)
	app:fill("#task-card-title", "Draft the onboarding copy now")
	app:frames(5)
	expect(calls(app)).never.to_contain("update:t4:title")
	app:wait(600)
	app:frames(5)
	expect(calls(app)).to_contain("update:t4:title=Draft the onboarding copy now")
	app:click("#task-card-menu")
	app:frames(10)
	app:click("#task-card-delete")
	app:frames(20)
	expect(calls(app)).to_contain("delete:t4")
	expect(app:has("#task-card")).to_be(false)
end)

test("assigning to a thread links it, sends only when asked, and opens nothing", function()
	local app = open()
	app:click("#task-row-t4")
	app:frames(20)
	app:click('#task-card-hand-off >> "Thread"')
	app:frames(10)
	app:type("#task-card-assign", "Tidy")
	app:frames(5)
	app:key("Enter")
	app:frames(10)
	expect(app:has("#task-card-assign-picked")).to_be(true)
	app:click("#task-card-link")
	app:frames(20)
	expect(calls(app)).to_contain("assign:t4:a3:false")
	expect(app:state("shell_route_path")).to_be("/plugin/zeron/tasks")
	expect(app:tree("#task-card-linked")).to_contain("Tidy the tests")
	app:click("#task-card-unassign")
	app:frames(10)
	expect(calls(app)).to_contain("assign:t4::false")
end)

test("the board: four columns, each task in the one its state says", function()
	local app = open()
	app:click('#tasks-view >> "Kanban"')
	app:frames(30)
	expect(app:has("#tasks-column-todo >> #task-kanban-t4")).to_be(true)
	expect(app:has("#tasks-column-working >> #task-kanban-t2")).to_be(true)
	expect(app:has("#tasks-column-needs >> #task-kanban-t1")).to_be(true)
	expect(app:has("#tasks-column-needs >> #task-kanban-t8")).to_be(true)
	expect(app:has("#tasks-column-done >> #task-kanban-t9")).to_be(true)
	expect(app:has("#tasks-column-todo >> #task-kanban-t1")).to_be(false)
	app:click("#task-kanban-t4")
	app:frames(20)
	expect(app:has("#task-card")).to_be(true)
end)

test("a thousand tasks: only the rows in view are built, to the very last", function()
	local app = open("fixture.tasks_many")
	expect(app:tree("#tasks-subtitle")).to_contain("1,000 to do")
	local most = rows(app)
	expect(most > 0).to_be(true)
	for _, y in { 5000, 20000, 46000 } do
		app:set_state("tasks_scroll", y)
		app:frames(3)
		most = math.max(most, rows(app))
	end
	expect(most < 40).to_be(true)
	app:set_state("tasks_scroll", 100000)
	app:frames(5)
	expect(app:has("#task-row-m1000")).to_be(true)
	expect(app:has("#task-row-m1")).to_be(false)
end)

test("a host without tasks: the page shows nothing to do and a write says nothing went", function()
	local app = open("fixture.tasks_old_host")
	expect(app:tree("#tasks-subtitle")).to_contain("Nothing to do")
	app:type("#tasks-add", "Lost")
	app:key("Enter")
	app:frames(5)
	expect(app:state("tasks_absent")).to_be(true)
end)
