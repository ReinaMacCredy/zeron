	expect(app:has("#task-kanban-t4")).to_be(true)
	expect(app:has("#task-row-t4")).to_be(false)
	app:click('#tasks-view >> "List"')
	app:frames(1)
	expect(app:has("#task-row-t4")).to_be(true)
	expect(app:has("#task-kanban-t4")).to_be(false)
end)

test("the List/Kanban switch shows each task once: the old view goes at once, the moving tasks carry them, and the new view shows once they land", function()
	local app = open()
	app:click('#tasks-view >> "Kanban"')
	app:frames(3)
	expect(app:has("#task-row-t4")).to_be(false)
	expect(app:state("tasks_morphing")).to_be(true)
	app:frames(60)
	expect(app:state("tasks_morphing")).to_be(false)
	app:click("#task-kanban-t4")
	app:frames(20)
	expect(app:has("#task-card")).to_be(true)
	app:key("Escape")
	app:frames(20)
	app:click('#tasks-view >> "List"')
	app:frames(3)
	expect(app:has("#task-kanban-t4")).to_be(false)
	expect(app:state("tasks_morphing")).to_be(true)
	app:frames(60)
	expect(app:state("tasks_morphing")).to_be(false)
	app:click("#task-row-t4")
	app:frames(20)
	expect(app:has("#task-card")).to_be(true)
end)

test("the List/Kanban switch, frame by frame: a task never shows twice and never goes blank, and leaving the page mid-way leaves it whole", function()
	local app = open()
	local function step(real: string)
		for _ = 1, 45 do
			app:frames(1)
			local shown = 0
			for line in app:tree("#tasks-page"):gmatch("[^\n]+") do
				if line:find("Draft the onboarding copy", 1, true) and not line:find("hidden", 1, true) then
					shown += 1
				end
			end
			local real_shown = app:has(real) and not (app:tree(real):match("[^\n]+") or ""):find("hidden", 1, true)
			if app:state("tasks_morphing") then
				expect(real_shown).to_be(false)
			end
			expect(shown > 0).to_be(true)
		end
	end
	app:click('#tasks-view >> "Kanban"')
	step("#task-kanban-t4")
	app:frames(30)
	app:click('#tasks-view >> "List"')
	step("#task-row-t4")
	app:frames(30)
	app:click('#tasks-view >> "Kanban"')
	app:frames(2)
	app:click("#rail-skills")
	app:frames(30)
	app:click("#rail-tasks")
	app:frames(30)
	expect(app:state("tasks_morphing")).to_be(false)
	app:click("#task-kanban-t4")
	app:frames(20)
	expect(app:has("#task-card")).to_be(true)
end)
