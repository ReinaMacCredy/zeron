local function days(app: any, offset: number?, at: number?): string
	app:set_state("tasks_days_offset", offset)
	if at then
		app:set_state("tasks_days_at", at)
	end
	app:command("fixture.days")
	app:frames(1)
	return app:state("tasks_days") :: string
end

test("the day turns at 4 in the morning where you are, east or west of UTC", function()
	local app = open()
	local at = 1794200000
	expect(days(app, 7 * 3600, at)).to_be("4:0|true|2026-11-09|2026-11-10|2026-11-09|due Dec 3")
	expect(days(app, -8 * 3600, at)).to_be("4:0|true|2026-11-08|2026-11-09|2026-11-08|due Dec 3")
	expect(days(app, 13 * 3600, at)).to_be("4:0|true|2026-11-09|2026-11-10|2026-11-09|due Dec 3")
	expect(days(app, 7 * 3600, at - 10 * 3600)).to_be("4:0|true|2026-11-09|2026-11-10|2026-11-08|due Dec 3")
end)

test("the day sums in the machine's own zone agree with its clock", function()
	local app = open()
	local at = 1794200000
	local t = os.date("*t", at - 4 * 3600) :: any
	local want = `4:0|true|{os.date("%Y-%m-%d", at)}|{os.date("%Y-%m-%d", at + 86400)}|{string.format("%04d-%02d-%02d", t.year, t.month, t.day)}|due Dec 3`
	expect(days(app, nil, at)).to_be(want)
end)

