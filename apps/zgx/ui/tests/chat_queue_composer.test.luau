-- The window's composer wired to the queue (screens/chat/composer, asks) on
-- ui/chat_fixture.luau; `queue_held` keeps the engine's answers back.

local function running(app: any, id: string)
	app:command(`go_{id}`)
	app:frames(30)
	app:command("start_reply")
	app:frames(30)
end

test("a message sent while a turn runs is in the queue the frame it's sent", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	running(app, "s2")
	app:command("queue_held")
	app:type("role:textbox", "Then run the tests")
	app:key("Enter")
	app:frames(1)
	expect(app:has('role:listitem "1. Then run the tests"')).to_be(true)
	expect(app:state("calls")).to_contain("send:s2:Then run the tests")
	app:command("engine_answers")
	app:frames(30)
	expect(app:has('role:listitem "1. Then run the tests"')).to_be(true)
	expect(app:has('role:listitem "2. Then run the tests"')).to_be(false)
	expect(app:error()).to_be(nil)
end)

test("a message the queue refuses leaves it, and its words go back in the composer", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	running(app, "s2")
	app:command("queue_held")
	app:type("role:textbox", "Then run the tests")
	app:key("Enter")
	app:frames(1)
	expect(app:has('role:listitem "1. Then run the tests"')).to_be(true)
	app:command("engine_refuses")
	app:frames(30)
	expect(app:has('role:listitem "1. Then run the tests"')).to_be(false)
	expect(app:text("role:textbox")).to_be("Then run the tests")
end)

test("an answer belongs to the chat it was queued in, whichever shows by then", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	running(app, "s2")
	app:command("queue_held")
	app:type("role:textbox", "Then run the tests")
	app:key("Enter")
	app:frames(1)
	app:command("go_s1")
	app:frames(30)
	app:command("engine_refuses")
	app:frames(30)
	app:command("go_s2")
	app:frames(30)
	expect(app:has('role:listitem "1. Then run the tests"')).to_be(false)
	expect(app:text("role:textbox")).to_be("Then run the tests")
end)

test("a queue action refused says so in the composer's own line", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	running(app, "s2")
	app:command("queue_one")
	app:frames(30)
	app:command("queue_held")
	-- (The deck's Queue, opened from its folded pill.)
	app:click('role:button "Open Queue"')
	app:frames(30)
	app:hover('role:listitem "1. Queued words"')
	app:frames(5)
	app:click('role:button "Remove"')
	app:frames(1)
	expect(app:has('role:button "Removing…"')).to_be(true)
	app:command("engine_refuses")
	app:frames(30)
	expect(app:has('~"Couldn\'t remove the message"')).to_be(true)
	expect(app:has('role:listitem "1. Queued words"')).to_be(true)
end)
