test("the edit page offers Full access alone to an agent whose catalog names no mode", function()
	local app = mount("chat_fixture.luau")
	app:command("catalog_full_only")
	on_planner(app)
	card(app)
	app:click('role:option "Save current as profile"')
	settle(app)
	app:click("#profile-edit-mode")
	settle(app)
	expect(shows(app, 'option "Supervised"')).to_be(true)
	app:key("Escape")
	settle(app)
	app:click("#profile-edit-harness")
	settle(app)
	app:click('role:option "Fx"')
	settle(app)
	app:click("#profile-edit-mode")
	settle(app)
	expect(shows(app, 'option "Keep current"')).to_be(true)
	expect(shows(app, 'option "Full access"')).to_be(true)
	expect(shows(app, 'option "Supervised"')).to_be(false)
	expect(shows(app, 'option "Auto-accept edits"')).to_be(false)
end)
