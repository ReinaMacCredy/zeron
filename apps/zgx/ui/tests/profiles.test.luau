test("a new chat takes a profile's picks at once and sends with it", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_home")
	settle(app)
	app:click('#chat-composer >> role:button "Model"')
	settle(app)
	app:click("#model-picker-layout")
	settle(app)
	app:click("#model-tab-profiles")
	settle(app)
	settle(app)
	app:click('role:option "Planner"')
	settle(app)
	expect(app:state("chat_profile")).to_be("planner")
	expect(app:state("chat_model")).to_be("opus")
	expect(app:state("chat_effort")).to_be("high")
	expect(app:state("chat_access")).to_be("edits")
	expect(app:has('role:button "Planner · Change profile"')).to_be(true)
	-- Its drift is the host's word on the new chat's picks.
	app:set_state("chat_effort", "low")
	settle(app)
	expect(shows(app, "#picker-model-profile-drift")).to_be(true)
	app:set_state("ds/model_picker.luau::model_picker_compact", true)
	-- Sent, the new chat goes with it.
	app:type('role:textbox "Message"', "Plan the release")
	app:key("Enter")
	settle(app)
	expect(app:state("calls")).to_contain("send:new1:Plan the release")
	expect(app:state("calls")).to_contain("send_profile:planner")
end)

test("Tab walks the edit page's fields and keeps the card and its draft (it never closes it as a menu's Tab would)", function()
	local app = mount("chat_fixture.luau")
	on_planner(app)
	card(app)
	app:click('role:option "Save current as profile"')
	settle(app)
	app:fill('role:textbox "Name"', "Kept")
	expect(app:tree('role:textbox "Name"')).to_contain(" focused")
	app:key("Tab")
	settle(app)
	expect(shows(app, "#profile-edit-title")).to_be(true)
	expect(app:text('role:textbox "Name"')).to_be("Kept")
	expect(app:tree("#profile-edit-harness")).to_contain(" focused")
	app:key("Tab")
	settle(app)
	expect(app:tree("#profile-edit-model")).to_contain(" focused")
	app:key("shift+Tab")
	app:key("shift+Tab")
	settle(app)
	expect(app:tree('role:textbox "Name"')).to_contain(" focused")
	expect(shows(app, "#profile-edit-title")).to_be(true)
end)

