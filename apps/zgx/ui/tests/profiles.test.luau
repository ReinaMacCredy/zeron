-- Agent profiles from the composer, on ui/chat_fixture.luau (its profiles
-- host answers as src/agent_profiles.rs would): the chip's profile half and
-- its drift dot, the profiles card's keys, apply, Revert and Save, its edit
-- page, a new chat's profile and the card's errors.

local function settle(app: any)
	app:frames(30)
end
local function open(app: any, id: string)
	app:command(`go_{id}`)
	settle(app)
end
local function shows(app: any, target: string): boolean
	for line in app:tree():gmatch("[^\n]+") do
		if line:find(target, 1, true) and not line:find(" hidden", 1, true) then
			return true
		end
	end
	return false
end
local function box(app: any, sel: string): { x: number, y: number, w: number, h: number }
	local line = string.match(app:tree(sel), "[^\n]+") or ""
	local x, y, w, h = string.match(line, "(-?[%d.]+),(-?[%d.]+) ([%d.]+)x([%d.]+)")
	return { x = tonumber(x) or -1, y = tonumber(y) or -1, w = tonumber(w) or -1, h = tonumber(h) or -1 }
end
local function on_planner(app: any)
	app:resize(900, 700)
	app:command("s2_on_planner")
	settle(app)
	open(app, "s2")
end
local function card(app: any)
	app:click("#picker-model-profile")
	settle(app)
end

test("a profiled chat's chip is two: the profile's half says it and opens the card in one click", function()
	local app = mount("chat_fixture.luau")
	on_planner(app)
	expect(app:has('role:button "Planner · Change profile"')).to_be(true)
	expect(shows(app, "#picker-model-profile-drift")).to_be(false)
	card(app)
	expect(shows(app, 'option "No profile"')).to_be(true)
	expect(shows(app, 'option "Planner"')).to_be(true)
	expect(shows(app, 'option "Scout"')).to_be(true)
	expect(shows(app, '"by agent"')).to_be(true)
	expect(shows(app, '"Active"')).to_be(true)
	expect(app:tree('role:textbox "Search profiles…"')).to_contain(" focused")
	-- Another agent's: "switch".
	expect(shows(app, '"switch"')).to_be(true)
	-- The model's half still opens the model picker.
	app:key("Escape")
	settle(app)
	app:click('#chat-composer >> role:button "Model"')
	settle(app)
	expect(shows(app, "#model-picker-title")).to_be(true)
	expect(shows(app, 'option "No profile"')).to_be(false)
end)

test("Up, Down and Enter walk the card and apply; Escape closes it and the draft has the keys", function()
	local app = mount("chat_fixture.luau")
	on_planner(app)
	card(app)
	-- On Planner; down past Reviewer to Scout (the same agent, no model: no dialog).
	app:key("ArrowDown")
	app:key("ArrowDown")
	settle(app)
	app:key("Enter")
	settle(app)
	expect(app:state("calls")).to_contain("apply_profile:s2:scout")
	expect(app:has('role:button "Scout · Change profile"')).to_be(true)
	expect(shows(app, 'option "Planner"')).to_be(false)
	expect(app:tree('role:textbox "Message"')).to_contain(" focused")
	-- Escape on the card closes it, the keys back on the draft.
	card(app)
	expect(shows(app, 'option "Planner"')).to_be(true)
	app:key("Escape")
	settle(app)
	expect(shows(app, 'option "Planner"')).to_be(false)
	expect(app:tree('role:textbox "Message"')).to_contain(" focused")
end)

test("search narrows by name and notes; nothing found says so; No profile drops it", function()
	local app = mount("chat_fixture.luau")
	on_planner(app)
	card(app)
	app:type('role:textbox "Search profiles…"', "delegate")
	settle(app)
	expect(shows(app, 'option "Scout"')).to_be(true)
	expect(shows(app, 'option "Planner"')).to_be(false)
	expect(shows(app, 'option "No profile"')).to_be(false)
	app:fill('role:textbox "Search profiles…"', "zzz")
	settle(app)
	expect(shows(app, '"No profiles found"')).to_be(true)
	app:fill('role:textbox "Search profiles…"', "")
	settle(app)
	app:click('role:option "No profile"')
	settle(app)
	expect(app:state("calls")).to_contain("apply_profile:s2:none")
	expect(app:has("#picker-model-profile")).to_be(false)
end)

test("the drift dot shows once the chat moves from its profile; Revert puts it back, Save writes it in", function()
	local app = mount("chat_fixture.luau")
	on_planner(app)
	expect(shows(app, "#picker-model-profile-drift")).to_be(false)
	-- Another effort, picked here: the dot, Edited and the drift line.
	app:set_state("chat_effort", "low")
	settle(app)
	expect(shows(app, "#picker-model-profile-drift")).to_be(true)
	card(app)
	expect(shows(app, '"Edited"')).to_be(true)
	expect(shows(app, '"effort High → Low"')).to_be(true)
	app:click("#profile-revert-planner")
	settle(app)
	expect(app:state("calls")).to_contain("apply_profile:s2:planner")
	expect(app:state("chat_effort")).to_be("high")
	expect(shows(app, "#picker-model-profile-drift")).to_be(false)
	expect(shows(app, 'option "Planner"')).to_be(false)
	-- Again, then Save: the profile takes the chat's effort.
	app:set_state("chat_effort", "medium")
	settle(app)
	expect(shows(app, "#picker-model-profile-drift")).to_be(true)
	card(app)
	app:click("#profile-save-planner")
	settle(app)
	expect(app:state("calls")).to_contain("absorb:planner")
	expect(shows(app, "#picker-model-profile-drift")).to_be(false)
	expect(shows(app, '"Claude · Opus · Auto-accept edits · Medium"')).to_be(true)
end)

test("instructions alone drift with Revert and no Save", function()
	local app = mount("chat_fixture.luau")
	on_planner(app)
	app:set_state("test_patch", { instructions = "Something else" })
	app:command("patch_open")
	app:command("s2_on_planner")
	settle(app)
	card(app)
	expect(shows(app, '"instructions changed"')).to_be(true)
	expect(app:has("#profile-revert-planner")).to_be(true)
	expect(shows(app, "#profile-save-planner")).to_be(false)
end)

test("another agent's profile on a chat with history asks first; No changes nothing and the card is back", function()
	local app = mount("chat_fixture.luau")
	app:command("catalog_grows")
	on_planner(app)
	card(app)
	app:click('role:option "Quick"')
	settle(app)
	expect(app:has('~"Switch provider?"')).to_be(true)
	expect(app:state("calls")).never.to_contain("apply_profile:s2:quick")
	app:key("2")
	settle(app)
	app:wait("#a-moment-passes", { timeout_ms = 200 })
	settle(app)
	expect(shows(app, 'option "Quick"')).to_be(true)
	app:click('role:option "Quick"')
	settle(app)
	app:key("1")
	settle(app)
	expect(app:state("calls")).to_contain("apply_profile:s2:quick|note")
	expect(app:has('role:button "Quick · Change profile"')).to_be(true)
	-- The keys back to the draft once the dialog has gone.
	app:wait("#a-moment-passes", { timeout_ms = 500 })
	settle(app)
	expect(app:tree('role:textbox "Message"')).to_contain(" focused")
end)

test("applying a profile on a chat with none: the full picker's Profiles tab, the chip says it, the composer stays put", function()
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	open(app, "s2")
	expect(app:has("#picker-model-profile")).to_be(false)
	local before = box(app, "#chat-composer")
	app:click('#chat-composer >> role:button "Model"')
	settle(app)
	app:click("#model-picker-layout")
	settle(app)
	app:click("#model-tab-profiles")
	settle(app)
	settle(app)
	expect(shows(app, 'option "Scout"')).to_be(true)
	app:click('role:option "Scout"')
	settle(app)
	expect(app:state("calls")).to_contain("apply_profile:s2:scout")
	expect(app:has('role:button "Scout · Change profile"')).to_be(true)
	-- (The keys back on the draft, not on the Model chip the picker opened from.)
	settle(app)
	expect(app:tree('role:textbox "Message"')).to_contain(" focused")
	local after = box(app, "#chat-composer")
	expect(after.y).to_be(before.y)
	expect(after.h).to_be(before.h)
	-- The tab's dot while a profile is applied, none with none.
	app:click('#chat-composer >> role:button "Model"')
	settle(app)
	expect(shows(app, "#model-tab-profiles-dot")).to_be(true)
	app:key("Escape")
	settle(app)
	app:click("#picker-model-profile")
	settle(app)
	app:click('role:option "No profile"')
	settle(app)
	app:click('#chat-composer >> role:button "Model"')
	settle(app)
	expect(shows(app, "#model-tab-profiles")).to_be(true)
	expect(shows(app, "#model-tab-profiles-dot")).to_be(false)
	app:set_state("ds/model_picker.luau::model_picker_compact", true)
end)

test("Escape steps out of the edit page: the chooser, then the field opened out, then the page", function()
	local app = mount("chat_fixture.luau")
	on_planner(app)
	card(app)
	app:hover('role:option "Planner"')
	settle(app)
	app:click("#profile-quick-edit-planner")
	settle(app)
	expect(app:has('~"Edit Planner"')).to_be(true)
	expect(app:tree('role:textbox "Name"')).to_contain(" focused")
	app:click("#profile-edit-model")
	settle(app)
	expect(shows(app, "#profile-edit-choices")).to_be(true)
	app:key("Escape")
	settle(app)
	expect(shows(app, "#profile-edit-choices")).to_be(false)
	expect(shows(app, "#profile-edit-title")).to_be(true)
	app:click("#profile-edit-notes-expand")
	settle(app)
	expect(shows(app, "#profile-edit-folded")).to_be(true)
	expect(shows(app, "#profile-edit-notes-count")).to_be(true)
	app:key("Escape")
	settle(app)
	expect(shows(app, "#profile-edit-folded")).to_be(false)
	app:key("Escape")
	settle(app)
	expect(shows(app, "#profile-edit-title")).to_be(false)
	expect(shows(app, 'option "Planner"')).to_be(true)
	app:key("Escape")
	settle(app)
	expect(shows(app, 'option "Planner"')).to_be(false)
end)

test("the edit page saves what's typed and chosen; a name is needed; the engine's words show", function()
	local app = mount("chat_fixture.luau")
	app:command("catalog_grows")
	on_planner(app)
	card(app)
	app:hover('role:option "Planner"')
	settle(app)
	app:click("#profile-quick-edit-planner")
	settle(app)
	expect(app:text("#profile-edit-model")).to_contain("Opus")
	-- Picking another agent clears the model; back to Claude, it stays clear.
	app:click("#profile-edit-harness")
	settle(app)
	expect(shows(app, 'option "Claude"')).to_be(true)
	app:click('role:option "Codex"')
	settle(app)
	expect(app:text("#profile-edit-model")).to_contain("Keep current")
	app:click("#profile-edit-harness")
	settle(app)
	app:click('role:option "Claude"')
	settle(app)
	expect(app:text("#profile-edit-model")).to_contain("Keep current")
	-- The back button leaves a chooser without picking.
	app:click("#profile-edit-effort")
	settle(app)
	app:click("#profile-edit-back")
	settle(app)
	expect(shows(app, "#profile-edit-choices")).to_be(false)
	app:click("#profile-edit-effort")
	settle(app)
	app:click('role:option "Low"')
	settle(app)
	expect(app:text("#profile-edit-effort")).to_contain("Low")
	app:fill('role:textbox "Name"', "  ")
	app:click("#profile-edit-save")
	settle(app)
	expect(app:text("#profile-edit-error")).to_be("Give the profile a name.")
	app:fill('role:textbox "Name"', "Planner two")
	app:command("profiles_save_fails")
	app:click("#profile-edit-save")
	settle(app)
	expect(app:text("#profile-edit-error")).to_be("Profile name must not exceed 80 characters")
	expect(app:state("calls")).to_contain("save_profile:planner:Planner two")
end)

