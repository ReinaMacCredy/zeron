test("Save current as profile opens the page on the chat's picks; Use current selection takes them again; More… hands it to Settings", function()
	local app = mount("chat_fixture.luau")
	on_planner(app)
	card(app)
	app:click('role:option "Save current as profile"')
	settle(app)
	expect(app:has('~"New profile"')).to_be(true)
	expect(app:text("#profile-edit-model")).to_contain("Opus")
	app:click("#profile-edit-model")
	settle(app)
	app:click('role:option "Keep current"')
	settle(app)
	expect(app:text("#profile-edit-model")).to_contain("Keep current")
	app:click("#profile-edit-use-current")
	settle(app)
	expect(app:text("#profile-edit-model")).to_contain("Opus")
	app:fill('role:textbox "Name"', "Handed over")
	app:click("#profile-edit-more")
	settle(app)
	expect(shows(app, 'option "Planner"')).to_be(false)
	expect(app:state("profiles_pending_edit")).to_be_truthy()
end)

