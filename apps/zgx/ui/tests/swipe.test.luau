-- A two-finger swipe through the history (crates/ui swipe.rs, shell/swipe_nav.rs): how
-- the fingers are read, on its own, and the same through the window's input, the pill
-- following them. On the shell in ui/shell_fixture.luau.

local swipe = require("../screens/shell/swipe_tracker")

local function tracker(): any
	return swipe.Tracker()
end

test("past the arm, letting go commits; short of it, it cancels", function()
	local t = tracker()
	t.feed("began", 0, 0, 0)
	-- (Zeron's travel is against zgx's scroll: fingers right, dx negative, is Back.)
	local step, travel = t.feed("moved", -120, 0, 400)
	expect(step).to_be("track")
	expect(travel).to_be(120)
	local done, sign = t.feed("ended", 0, 0, 800)
	expect(done).to_be("commit")
	expect(sign).to_be(1)

	t = tracker()
	t.feed("began", 0, 0, 0)
	t.feed("moved", -60, 0, 400)
	expect((t.feed("ended", 0, 0, 800))).to_be("cancel")
end)

test("a flick commits short of the arm, against its own way it doesn't", function()
	local t = tracker()
	t.feed("began", 0, 0, 0)
	t.feed("moved", 10, 0, 16)
	t.feed("moved", 30, 0, 32)
	local done, sign = t.feed("ended", 0, 0, 48)
	expect(done).to_be("commit")
	expect(sign).to_be(-1)

	-- Too short to be one.
	t = tracker()
	t.feed("began", 0, 0, 0)
	t.feed("moved", 10, 0, 16)
	expect((t.feed("ended", 0, 0, 32))).to_be("cancel")

	-- Far along, turned back fast: not past the arm any more, and the speed's against it.
	t = tracker()
	t.feed("began", 0, 0, 0)
	t.feed("moved", -90, 0, 400)
	t.feed("moved", 40, 0, 416)
	expect((t.feed("ended", 0, 0, 432))).to_be("cancel")
end)

test("a swipe gone still, or left unfinished, ends itself", function()
	local t = tracker()
	t.feed("began", 0, 0, 0)
	t.feed("moved", -40, 0, 100)
	-- (Moving, then silence: long to give it, in case the fingers only paused.)
	expect(t.expire(5000)).to_be(false)
	expect(t.expire(8200)).to_be(true)
	expect(t.swiping()).to_be(false)

	t = tracker()
	t.feed("began", 0, 0, 0)
	t.feed("moved", -40, 0, 100)
	t.feed("moved", 0, 0, 200)
	expect(t.expire(500)).to_be(false)
	expect(t.expire(800)).to_be(true)
end)

test("the pill comes in with the fingers, rubber-banding past the arm; with nothing to go to it only peeks", function()
	expect(swipe.center(0, true)).to_be(-30)
	expect(swipe.center(110, true)).to_be(44)
	expect(swipe.center(4000, true) < 54.01).to_be(true)
	expect(swipe.center(200, true) > 44).to_be(true)
	expect(swipe.center(110, false)).to_be(6)
	expect(swipe.center(4000, false)).to_be(6)
end)

local function shell(): any
	local app = mount("shell_fixture.luau")
	app:resize(1400, 800)
	app:frames(30)
	app:click('#shell-sidebar >> role:button "Fix the build"')
	app:frames(30)
	app:click('#shell-sidebar >> role:button "Write the docs"')
	app:frames(30)
	return app
end

local function route_has(app: any, id: string): boolean
	return tostring(app:state("shell_route_path")):find(id, 1, true) ~= nil
end

test("fingers across the page pull the pill in and past the arm go back, the page sliding in", function()
	local app = shell()
	app:gesture("began")
	-- (Fingers to the right: Back.)
	app:scroll("#shell-page", 0, -60)
	app:frames(2)
	expect(app:has("#swipe-pill")).to_be(true)
	app:scroll("#shell-page", 0, -70)
	app:frames(2)
	expect(route_has(app, "a2")).to_be(true)
	app:gesture("ended")
	app:frames(40)
	expect(route_has(app, "a1")).to_be(true)
	expect(app:has("#swipe-pill")).to_be(false)
	-- And forward, the other way.
	app:gesture("began")
	app:scroll("#shell-page", 0, 130)
	app:frames(2)
	app:gesture("ended")
	app:frames(40)
	expect(route_has(app, "a2")).to_be(true)
	expect(app:error()).to_be_nil()
end)

test("let go short of the arm, it springs back and stays", function()
	local app = shell()
	app:gesture("began")
	app:scroll("#shell-page", 0, -40)
	app:frames(2)
	expect(app:has("#swipe-pill")).to_be(true)
	app:frames(30)
	app:gesture("ended")
	app:frames(40)
	expect(route_has(app, "a2")).to_be(true)
	expect(app:has("#swipe-pill")).to_be(false)
	expect(app:error()).to_be_nil()
end)

test("with nothing ahead, a swipe forward only peeks, and goes nowhere", function()
	local app = shell()
	app:gesture("began")
	app:scroll("#shell-page", 0, 200)
	app:frames(2)
	expect(app:has("#swipe-pill")).to_be(true)
	app:gesture("ended")
	app:frames(40)
	expect(route_has(app, "a2")).to_be(true)
	expect(app:has("#swipe-pill")).to_be(false)
	expect(app:error()).to_be_nil()
end)

test("a swipe mostly up and down scrolls the chat: no pill, no step", function()
	local app = shell()
	app:gesture("began")
	app:scroll("#shell-page", 40, -10)
	app:frames(2)
	expect(app:has("#swipe-pill")).to_be(false)
	app:gesture("ended")
	app:frames(20)
	expect(route_has(app, "a2")).to_be(true)
	expect(app:error()).to_be_nil()
end)

test("a swipe over an open modal steps nothing under it", function()
	local app = shell()
	local before = app:state("shell_route_path")
	app:set_state("shell_palette_open", true)
	app:frames(20)
	app:gesture("began")
	app:scroll("#shell-page", 0, -130)
	app:frames(2)
	app:gesture("ended")
	app:frames(30)
	expect(app:state("shell_route_path")).to_be(before)
	expect(app:has("#swipe-pill")).to_be(false)
	expect(app:error()).to_be_nil()
end)

test("a new swipe during the pill's spring back takes the pill over", function()
	local app = shell()
	app:gesture("began")
	app:scroll("#shell-page", 0, -60)
	app:frames(2)
	app:gesture("ended")
	app:frames(3)
	app:gesture("began")
	app:scroll("#shell-page", 0, -60)
	app:frames(30)
	expect(app:has("#swipe-pill")).to_be(true)
	expect(app:state("shell_swipe_center") > 0).to_be(true)
	app:gesture("ended")
	app:frames(40)
	expect(app:has("#swipe-pill")).to_be(false)
	expect(app:error()).to_be_nil()
end)
