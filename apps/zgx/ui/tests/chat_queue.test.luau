-- The queue answers at once and says what went wrong in Zeron's words, on
-- ui/queue_fixture.luau (ds/composer_dock over screens/chat/asks; the engine
-- answers only when a test says so, as a chat on another device keeps the page
-- waiting a round trip).

local function row(name: string): string
	return `role:listitem "{name}"`
end

local function session(queue: { any }, fields: { [string]: any }?): any
	local s: { [string]: any } = { id = "s1", running = true, steers = true, stopped = false, queue = queue }
	for k, v in fields or {} do
		s[k] = if v == "none" then nil else v
	end
	return s
end

local TWO = { { id = "q1", text = "First queued" }, { id = "q2", text = "Second queued" } }

local function press(app: any, name: string, button: string)
	app:hover(row(name))
	app:frames(5)
	app:click(`{row(name)} >> role:button "{button}"`)
end

local function open(queue: { any }, fields: { [string]: any }?): any
	local app = mount("queue_fixture.luau")
	app:resize(900, 700)
	app:set_state("test_session", session(queue, fields))
	app:frames(30)
	return app
end

test("a row's one action follows what the agent can do", function()
	local app = open({ { id = "q1", text = "Plain" }, { id = "q2", text = "With a file", cargo = { { kind = "file", name = "a.txt" } } } })
	expect(app:has(`{row("1. Plain")} >> role:button "Steer"`)).to_be(true)
	expect(app:has(`{row("2. With a file")} >> role:button "Send now"`)).to_be(true)

	app:set_state("test_session", session({ { id = "q1", text = "Plain" } }, { steers = false }))
	app:frames(5)
	expect(app:has(`{row("1. Plain")} >> role:button "Send next"`)).to_be(true)

	app:set_state("test_session", session({ { id = "q1", text = "Plain" } }, { steers = "none" }))
	app:frames(5)
	local unknown = `{row("1. Plain")} >> role:button "Send now"`
	expect(app:has(unknown)).to_be(true)
	expect(app:tree(unknown)).to_contain("disabled")
	app:click(unknown)
	app:frames(2)
	expect(app:state("calls")).never.to_contain("queue:")
	expect(app:error()).to_be(nil)
end)

test("an old host, with no steers and no stopped, reads as it always did", function()
	local app = open({ { id = "q1", text = "Plain" } }, { steers = "none", stopped = "none" })
	expect(app:has(`{row("1. Plain")} >> role:button "Steer"`)).to_be(true)
	app:set_state("test_session", session({ { id = "q1", text = "Plain" } }, { steers = "none", stopped = "none", running = false }))
	app:frames(5)
	expect(app:has(`{row("1. Plain")} >> role:button "Send next"`)).to_be(true)
end)

test("a store that answers nothing leaves the row where it was", function()
	local app = open(TWO)
	app:set_state("test_old_store", true)
	app:click(`{row("1. First queued")} >> role:button "Steer"`)
	app:frames(2)
	expect(app:state("calls")).to_contain("queue:s1:send:q1")
	expect(app:has(row("1. First queued"))).to_be(true)
	press(app, "1. First queued", "Remove")
	app:frames(2)
	expect(app:state("calls")).to_contain("queue:s1:remove:q1")
	expect(app:has(`{row("1. First queued")} >> role:button "Remove"`)).to_be(true)
	app:drag(row("2. Second queued"), row("1. First queued"))
	app:frames(2)
	expect(app:state("calls")).to_contain("queue:s1:move:q2")
	expect(app:has(row("1. First queued"))).to_be(true)
	expect(app:error()).to_be(nil)
end)

test("Steer takes a row out of the queue the frame it's pressed", function()
	local app = open(TWO)
	app:click(`{row("1. First queued")} >> role:button "Steer"`)
	app:frames(1)
	expect(app:state("calls")).to_contain("queue:s1:send:q1")
	expect(app:has(row("1. Second queued"))).to_be(true)
	expect(app:tree()).never.to_contain("First queued")
	app:command("engine_answers")
	app:frames(5)
	expect(app:has(row("1. Second queued"))).to_be(true)
end)

test("a steer refused puts the row back and says why", function()
	local app = open(TWO)
	app:click(`{row("1. First queued")} >> role:button "Steer"`)
	app:frames(1)
	expect(app:has(row("1. First queued"))).to_be(false)
	app:command("engine_refuses")
	app:frames(5)
	expect(app:has(row("1. First queued"))).to_be(true)
	expect(app:state("test_notice")).to_be("Couldn't send that message: failed")
end)

test("a row that had already left says nothing when sent", function()
	local app = open(TWO)
	app:click(`{row("1. First queued")} >> role:button "Steer"`)
	app:frames(1)
	app:command("engine_gone")
	app:frames(5)
	expect(app:state("test_notice")).to_be("")
end)

test("Send next moves the row first at once, and back if refused", function()
	local app = open(TWO, { steers = false })
	app:click(`{row("2. Second queued")} >> role:button "Send next"`)
	app:frames(1)
	expect(app:has(row("1. Second queued"))).to_be(true)
	expect(app:has(row("2. First queued"))).to_be(true)
	app:command("engine_refuses")
	app:frames(5)
	expect(app:has(row("1. First queued"))).to_be(true)
	expect(app:state("test_notice")).to_be("Couldn't send that message: failed")
end)

test("Remove reads Removing… at .55 until the engine answers, then the row goes", function()
	local app = open(TWO)
	press(app, "1. First queued", "Remove")
	app:frames(1)
	expect(app:has(`{row("1. First queued")} >> role:button "Removing…"`)).to_be(true)
	expect(app:has(`{row("1. First queued")} >> role:button "Remove"`)).to_be(false)
	app:command("engine_answers")
	app:frames(5)
	expect(app:has(row("1. First queued"))).to_be(false)
	expect(app:has(row("1. Second queued"))).to_be(true)
end)

test("a removal that failed says Zeron's words, the row back as it was", function()
	local app = open(TWO)
	press(app, "1. First queued", "Remove")
	app:frames(1)
	app:command("engine_refuses")
	app:frames(5)
	expect(app:has(`{row("1. First queued")} >> role:button "Remove"`)).to_be(true)
	expect(app:state("test_notice")).to_be("Couldn't remove the message")

	press(app, "1. First queued", "Remove")
	app:frames(1)
	app:command("engine_gone")
	app:frames(5)
	expect(app:state("test_notice")).to_be("That message had already left the queue")
end)

test("a message sent while a turn runs shows at once and keeps its row as the engine's copy comes", function()
	local app = open(TWO)
	app:command("add")
	app:frames(1)
	expect(app:has(row("3. Then run the tests"))).to_be(true)
	local was = string.match(app:tree(row("3. Then run the tests")), "@%d+")
	expect(app:has(`{row("3. Then run the tests")} >> role:button "Remove"`)).to_be(true)
	expect(app:tree(`{row("3. Then run the tests")} >> role:button "Remove"`)).to_contain("disabled")
	app:command("add_taken")
	app:frames(5)
	expect(app:has(row("3. Then run the tests"))).to_be(true)
	expect(app:has(row("4. Then run the tests"))).to_be(false)
	expect(string.match(app:tree(row("3. Then run the tests")), "@%d+")).to_be(was)
	expect(app:tree(`{row("3. Then run the tests")} >> role:button "Remove"`)).never.to_contain("disabled")
end)

test("a message that did not reach the engine leaves the queue", function()
	local app = open(TWO)
	app:command("add")
	app:frames(1)
	app:command("add_failed")
	app:frames(5)
	expect(app:has(row("3. Then run the tests"))).to_be(false)
end)

test("a message the engine ran rather than queued leaves the queue", function()
	local app = open(TWO)
	app:command("add")
	app:frames(1)
	app:command("add_ran")
	app:frames(5)
	expect(app:has(row("3. Then run the tests"))).to_be(false)
end)

test("Steer all shows with two plain rows while the agent steers mid-turn", function()
	local app = open(TWO)
	expect(app:has('role:button "Steer all"')).to_be(true)
	app:set_state("test_session", session(TWO, { running = false }))
	app:frames(5)
	expect(app:has('role:button "Steer all"')).to_be(false)
	app:set_state("test_session", session(TWO, { steers = false }))
	app:frames(5)
	expect(app:has('role:button "Steer all"')).to_be(false)
	app:set_state("test_session", session({ TWO[1] }))
	app:frames(5)
	expect(app:has('role:button "Steer all"')).to_be(false)
	app:set_state("test_session", session({ TWO[1], { id = "q3", text = "Files", cargo = { { kind = "file", name = "a" } } } }))
	app:frames(5)
	expect(app:has('role:button "Steer all"')).to_be(false)
end)

test("Steer all leaves a row with files, which would interrupt, in the queue", function()
	local app = open({ TWO[1], { id = "q3", text = "Files", cargo = { { kind = "file", name = "a" } } }, TWO[2] })
	expect(app:tree('role:button "Steer all"')).to_contain("Steer 2 as one")
	expect(app:has('"stays · has a file"')).to_be(false)
	app:hover('role:button "Steer all"')
	app:frames(5)
	expect(app:tree(row("2. Files"))).to_contain("stays · has a file")
	expect(app:tree(row("1. First queued"))).never.to_contain("stays")
	app:click('role:button "Steer all"')
	app:frames(1)
	expect(app:state("calls")).to_contain("steer_all:s1:q1+q2")
	expect(app:has(row("1. Files"))).to_be(true)
	expect(app:has(row("1. First queued"))).to_be(false)
	app:command("engine_answers")
	app:frames(5)
	expect(app:has(row("1. Files"))).to_be(true)
end)

test("a queued row reads its words, not the blocks written for the agent", function()
	local sent = 'A2 Pick it\n\nĐã chọn trong "Frame":\nA = A2 (Top)\n\nOpen pages: close with html_render `close` each one this message answered or moved past.\n"Later": C (Rail)'
	local app = open({ { id = "q1", text = sent }, TWO[2] })
	local tree = app:tree('role:list "Queued messages"')
	expect(tree).to_contain("A2 Pick it")
	expect(tree).never.to_contain("Open pages")
	expect(tree).never.to_contain("Frame")
end)

test("Steer all refused puts the rows back and says why", function()
	local app = open(TWO)
	app:click('role:button "Steer all"')
	app:frames(1)
	expect(app:has(row("1. First queued"))).to_be(false)
	app:command("engine_refuses")
	app:frames(5)
	expect(app:has(row("1. First queued"))).to_be(true)
	expect(app:has(row("2. Second queued"))).to_be(true)
	expect(app:state("test_notice")).to_be("Couldn't send that message: failed")
end)

test("Steer all on a host without the action changes nothing", function()
	local app = open(TWO)
	app:set_state("test_no_steer_all", true)
	app:click('role:button "Steer all"')
	app:frames(2)
	expect(app:has(row("1. First queued"))).to_be(true)
	expect(app:error()).to_be(nil)
end)

test("a row dragged takes its place at once, and goes back if the engine refuses", function()
	local app = open(TWO)
	app:drag(row("2. Second queued"), row("1. First queued"))
	app:frames(1)
	expect(app:state("calls")).to_contain("queue:s1:move:q2:1")
	expect(app:has(row("1. Second queued"))).to_be(true)
	app:command("engine_refuses")
	app:frames(5)
	expect(app:has(row("1. First queued"))).to_be(true)
	expect(app:state("test_notice")).to_be("Couldn't reorder the queue: failed")
end)

test("a row in review reads so: its action off, its drag no move, Edit on", function()
	local app = open({ { id = "q1", text = "Secret words", review = true }, TWO[2] })
	local r = row("1. Secret words")
	expect(app:tree(r)).to_contain("Needs review")
	expect(app:tree(`{r} >> role:button "Send now"`)).to_contain("disabled")
	expect(app:tree(`{r} >> role:button "Edit"`)).never.to_contain("disabled")
	press(app, "1. Secret words", "Edit")
	app:frames(2)
	expect(app:state("calls")).to_contain("edit:q1")
	app:drag(r, row("2. Second queued"))
	app:frames(2)
	expect(app:state("calls")).never.to_contain("move")
end)

test("a row of files alone says what it carries", function()
	local app = open({
		{ id = "q1", text = "", cargo = { { kind = "image", name = "a.png", src = "assets/favicons/flint.png" } } },
		{ id = "q2", text = "  ", cargo = { { kind = "image", name = "a.png", src = "assets/favicons/flint.png" }, { kind = "file", name = "b.txt" } } },
	})
	expect(app:has('~"See the attached image(s)."')).to_be(true)
	expect(app:has('~"See the attached file(s)."')).to_be(true)
end)

test("thumbnails: two and how many more, one when narrow, a picture opening", function()
	local cargo = {
		{ kind = "image", name = "flint.png", src = "assets/favicons/flint.png" },
		{ kind = "file", name = "notes.txt" },
		{ kind = "file", name = "more.txt" },
	}
	local app = open({ { id = "q1", text = "Look", cargo = cargo } })
	local r = row("1. Look")
	expect(app:has(`{r} >> role:button "Open flint.png"`)).to_be(true)
	expect(app:tree(r)).to_contain("notes.txt")
	expect(app:tree(r)).to_contain("1 more: more.txt; edit message to view all")
	app:set_state("test_narrow", true)
	app:frames(5)
	expect(app:tree(r)).never.to_contain('"notes.txt"')
	expect(app:tree(r)).to_contain("2 more: notes.txt · more.txt")
	app:click(`{r} >> role:button "Open flint.png"`)
	app:frames(20)
	expect(app:state("ds/lightbox.luau::open")).never.to_be(nil)
end)

test("a row being saved reads Saving…, its buttons off", function()
	local app = open({ { id = "q1", text = "Words", editing = true } })
	local r = row("1. Words")
	expect(app:tree(r)).to_contain("Editing in composer")
	expect(app:tree(`{r} >> role:button "Cancel"`)).never.to_contain("disabled")
	app:set_state("test_saving", "q1")
	app:frames(5)
	expect(app:tree(r)).to_contain("Saving…")
	expect(app:tree(`{r} >> role:button "Save to queue"`)).to_contain("disabled")
	expect(app:tree(`{r} >> role:button "Cancel"`)).to_contain("disabled")
end)

test("a row sends after compaction says so", function()
	local app = open({ { id = "q1", text = "Words" } }, { compacting = true })
	expect(app:tree(row("1. Words"))).to_contain("Sends after compaction")
end)

test("the newest row's keys do nothing while it can't be acted on", function()
	for _, fields in { { steers = "none" }, {} } do
		local gated = if fields.steers then { id = "q1", text = "Words" } else { id = "q1", text = "Words", review = true }
		local app = open({ gated }, fields)
		app:command("send_newest")
		app:frames(2)
		expect(app:state("calls")).never.to_contain("queue:")
	end
	local app = open({ { id = "q1", text = "Words" } })
	app:command("send_newest")
	app:frames(2)
	expect(app:state("calls")).to_contain("queue:s1:send:q1")
end)

test("a picture sent while a turn runs shows as a picture before the engine has it", function()
	local app = open({})
	app:command("add_picture")
	app:frames(5)
	expect(app:has(`{row("1. Look")} >> role:button "Open flint.png"`)).to_be(true)
end)

test("a session not ready says nothing of its queue: a hide stays", function()
	local app = open(TWO)
	app:click(`{row("1. First queued")} >> role:button "Steer"`)
	app:frames(1)
	app:set_state("test_session", session(TWO, { queue = "none", state = "loading" }))
	app:frames(5)
	app:set_state("test_session", session(TWO))
	app:frames(5)
	expect(app:tree()).never.to_contain("First queued")
end)

test("a row sent on its way to an agent that takes turns only moves up, so it stays listed", function()
	local app = open(TWO, { steers = false })
	app:command("add")
	app:frames(1)
	app:command("send_newest")
	app:frames(1)
	app:command("add_taken")
	app:frames(10)
	expect(app:state("calls")).to_contain("queue:s1:send:eq1")
	expect(app:has(row("1. Then run the tests"))).to_be(true)
end)

test("a row sent while on its way goes once the engine has it, by the engine's id", function()
	local app = open(TWO)
	app:command("add")
	app:frames(1)
	app:command("send_newest")
	app:frames(1)
	expect(app:has(row("3. Then run the tests"))).to_be(false)
	expect(app:state("calls")).never.to_contain("queue:")
	app:command("add_taken")
	app:frames(5)
	expect(app:state("calls")).to_contain("queue:s1:send:eq1")
	expect(app:tree()).never.to_contain("Then run the tests")
end)
