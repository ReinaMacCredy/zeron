-- `@` lists threads (the shipping app's Threads section): this device's,
-- the open one never, searched as typed, each with its mark, title, how it
-- stands and its project, under "Threads" over the files; taken with the
-- keys, it lands as the chat's chip and goes as Zeron's chat link. On
-- ui/chat_fixture.luau.

local function open(): any
	local app = mount("chat_fixture.luau")
	app:resize(900, 700)
	app:command("go_s2")
	app:frames(30)
	app:command("threads_listed")
	app:frames(10)
	return app
end

test("@ threads: listed under Threads, the open chat and another device's left out", function()
	local app = open()
	app:type('role:textbox "Message"', "@")
	app:frames(20)
	expect(app:has("#mention-thread-s1")).to_be(true)
	expect(app:has("#mention-thread-s2")).to_be(false)
	expect(app:has("#mention-thread-far1")).to_be(false)
	local tree = app:tree("#mention-panel")
	-- (Its heading tracked in hair spaces, as the tree escapes them.)
	expect(tree).to_contain("T\\u{200a}H\\u{200a}R\\u{200a}E\\u{200a}A\\u{200a}D\\u{200a}S")
	-- How it stands, in words, and its project.
	expect(app:has('role:option "Long chat Working"')).to_be(true)
	expect(tree).to_contain("Atlas")
end)

test("@ threads: searched as typed, by title or the start of its id", function()
	local app = open()
	app:type('role:textbox "Message"', "@zzz")
	app:frames(20)
	expect(app:has("#mention-thread-s1")).to_be(false)
	app:fill('role:textbox "Message"', "@lon")
	app:frames(20)
	expect(app:has("#mention-thread-s1")).to_be(true)
	app:fill('role:textbox "Message"', "@s1")
	app:frames(20)
	expect(app:has("#mention-thread-s1")).to_be(true)
end)

test("@ threads: Enter takes the lit thread: its token goes, its chip comes, and it's sent as the chat link", function()
	local app = open()
	app:type('role:textbox "Message"', "Compare with @lon")
	app:frames(20)
	expect(app:has("#mention-thread-s1")).to_be(true)
	app:key("Enter")
	app:frames(20)
	expect(app:has("#mention-panel")).to_be(false)
	app:type('role:textbox "Message"', "this")
	app:key("Enter")
	app:frames(30)
	app:wait("#never-shown", { timeout_ms = 100 })
	local calls = app:state("calls")
	expect(calls).to_contain("](zeron-chat:s1)")
	expect(string.find(calls, "@lon", 1, true)).to_be(nil)
end)

test("@ threads: Tab takes it too, and the arrows reach the files below", function()
	local app = open()
	app:type('role:textbox "Message"', "@")
	app:frames(20)
	app:key("ArrowDown")
	app:frames(5)
	app:key("ArrowUp")
	app:frames(5)
	app:key("Tab")
	app:frames(20)
	expect(app:has("#mention-panel")).to_be(false)
	expect(app:has('~"Long chat"')).to_be(true)
end)

test("@ threads: the open chat can't be mentioned, dropped or typed", function()
	local app = open()
	app:type('role:textbox "Message"', "@sho")
	app:frames(20)
	expect(app:has("#mention-thread-s2")).to_be(false)
	app:command("mention_s2")
	app:frames(10)
	expect(app:tree("#chat-composer")).to_contain("This is the open thread")
end)
