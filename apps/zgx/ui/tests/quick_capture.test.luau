-- Quick capture on ui/tasks_fixture.luau.

local function open(): any
	local app = mount("tasks_fixture.luau")
	app:resize(1200, 800)
	app:frames(30)
	return app
end
local function calls(app: any): string
	return app:state("tasks_calls") :: string
end
-- (A modal that closed stays in the tree, hidden.)
local function shown(app: any, target: string): boolean
	return app:has(target) and not string.find((app:tree(target):match("[^\n]+")) or "", " hidden")
end
local function focused(app: any, target: string): boolean
	return (string.find((app:tree(target):match("[^\n]+")) or "", " focused")) ~= nil
end

local function on_tasks(app: any)
	app:click("#rail-tasks")
	app:frames(30)
	app:click("#tasks-subtitle")
	app:frames(5)
end

-- (Opened by its command, which ⌘⌥N runs: no shortcut reaches a command in these Linux tests.)
test("its command opens it; Enter saves to To do and it closes", function()
	local app = open()
	app:command("shell.quick_capture")
	app:frames(20)
	expect(shown(app, "#quick-capture")).to_be(true)
	expect(focused(app, "#quick-capture-input")).to_be(true)
	app:type("#quick-capture-input", "Call the bank")
	app:key("Enter")
	app:frames(20)
	expect(calls(app)).to_contain("create:Call the bank")
	expect(shown(app, "#quick-capture")).to_be(false)
	expect(app:has('"Added to To do: Call the bank"')).to_be(true)
end)

test("saved from the Tasks page, focus comes back to the page", function()
	local app = open()
	on_tasks(app)
	app:command("shell.quick_capture")
	app:frames(20)
	expect(focused(app, "#quick-capture-input")).to_be(true)
	app:type("#quick-capture-input", "Call the bank")
	app:key("Enter")
	app:frames(20)
	expect(focused(app, "#tasks-page")).to_be(true)
end)

test("Escape closes it with nothing saved, and focus goes back where it was", function()
	local app = open()
	on_tasks(app)
	app:command("shell.quick_capture")
	app:frames(20)
	app:type("#quick-capture-input", "Never mind")
	app:key("Escape")
	app:frames(20)
	expect(shown(app, "#quick-capture")).to_be(false)
	expect(calls(app)).never.to_contain("Never mind")
	expect(focused(app, "#tasks-page")).to_be(true)
end)

test("Shift+Enter starts the notes: the first line is the title, the rest the notes", function()
	local app = open()
	app:command("shell.quick_capture")
	app:frames(20)
	app:type("#quick-capture-input", "Plan the offsite")
	app:key("shift+Enter")
	app:type("#quick-capture-input", "book the room")
	app:key("Enter")
	app:frames(20)
	expect(calls(app)).to_contain("create:Plan the offsite|book the room")
end)

test("a capture is New on Tasks and counted on the rail until Tasks has shown it; Undo takes it back", function()
	local app = open()
	expect(app:has("#rail-tasks-badge")).to_be(false)
	app:command("shell.quick_capture")
	app:frames(20)
	app:type("#quick-capture-input", "Water the plants")
	app:key("Enter")
	app:frames(20)
	expect(app:tree("#rail-tasks-badge")).to_contain("1")
	app:click("#rail-tasks")
	app:frames(30)
	expect(app:has("#rail-tasks-badge")).to_be(false)
	expect(app:tree("#task-row-n101")).to_contain("New")
	app:click("#rail-inbox")
	app:frames(20)
	app:click("#rail-tasks")
	app:frames(30)
	expect(app:tree("#task-row-n101")).never.to_contain("New")
end)

test("the toast's Undo takes the capture back", function()
	local app = open()
	app:command("shell.quick_capture")
	app:frames(20)
	app:type("#quick-capture-input", "Oops")
	app:key("Enter")
	app:frames(20)
	app:click('role:button "Undo"')
	app:frames(20)
	expect(calls(app)).to_contain("delete:n101")
end)

test("a capture the engine refuses comes back with its words and what was typed", function()
	local app = open()
	app:command("fixture.tasks_refuse")
	app:command("shell.quick_capture")
	app:frames(20)
	app:type("#quick-capture-input", "Call the bank")
	app:key("Enter")
	app:frames(20)
	expect(shown(app, "#quick-capture")).to_be(true)
	expect(app:text("#quick-capture-input")).to_be("Call the bank")
	expect(app:has('"Start the task on the device that owns its project"')).to_be(true)
	expect(app:has('"Added to To do: Call the bank"')).to_be(false)
end)

local function capture(): any
	local app = open()
	app:command("shell.quick_capture")
	app:frames(20)
	return app
end

test("`/` lists the agent's commands a task's words can carry, and a pick is saved as its reference", function()
	local app = capture()
	app:type("#quick-capture-input", "/")
	app:frames(20)
	expect(calls(app)).to_contain("invocations:claude-code:home")
	expect(app:has('role:option "/review"')).to_be(true)
	expect(app:has('role:option "/btw"')).to_be(false)
	expect(app:has('role:option "/clear"')).to_be(false)
	app:key("Enter")
	app:frames(10)
	expect(app:text("#quick-capture-input")).to_be("/review ")
	app:type("#quick-capture-input", "the diff")
	app:key("Enter")
	app:frames(20)
	expect(calls(app)).to_contain("create:[/review](zeron-invoke:7b7d) the diff")
	expect(app:has('"Added to To do: /review the diff"')).to_be(true)
end)

test("`$` lists the skills, and a pick is saved as its reference", function()
	local app = capture()
	app:type("#quick-capture-input", "$")
	app:frames(20)
	expect(app:has('role:option "Code Review"')).to_be(true)
	app:key("Enter")
	app:frames(10)
	expect(app:text("#quick-capture-input")).to_be("$code-review ")
	app:type("#quick-capture-input", "the login page")
	app:key("Enter")
	app:frames(20)
	expect(calls(app)).to_contain("create:[$code-review](zeron-invoke:7b7d) the login page")
end)

test("`@` lists the tasks; a pick is a token in the words, saved as the task's link and depended on", function()
	local app = capture()
	app:type("#quick-capture-input", "Follow up on @port")
	app:frames(20)
	expect(app:has('role:option "Port the sidebar fold"')).to_be(true)
	expect(app:has('role:option "Fix the login redirect"')).to_be(false)
	app:key("Enter")
	app:frames(10)
	expect(app:text("#quick-capture-input")).to_be("Follow up on @Port-the-sidebar-fold ")
	app:key("Enter")
	app:frames(20)
	expect(calls(app)).to_contain("create:Follow up on [Port the sidebar fold](zeron-task:t2) depends=t2")
	expect(app:has('"Added to To do: Follow up on Port the sidebar fold"')).to_be(true)
end)

test("Escape puts an open menu away first, then closes the card", function()
	local app = capture()
	app:type("#quick-capture-input", "/")
	app:frames(20)
	expect(app:has('role:option "/review"')).to_be(true)
	app:key("Escape")
	app:frames(10)
	expect(shown(app, "#mention-popover")).to_be(false)
	expect(shown(app, "#quick-capture")).to_be(true)
	app:key("Escape")
	app:frames(20)
	expect(shown(app, "#quick-capture")).to_be(false)
	expect(calls(app)).never.to_contain("create:")
end)

test("a pasted picture shows under the words, comes off with its ×, and goes with the task; a file that isn't one is refused", function()
	local app = capture()
	app:command("fixture.capture_image")
	app:frames(20)
	expect(calls(app)).to_contain("upload:assets/pictures/circles.png")
	expect(calls(app)).never.to_contain("upload:assets/notes.txt")
	expect(app:has('"notes.txt is not an image."')).to_be(true)
	expect(app:has("#quick-capture-images")).to_be(true)
	app:hover("#quick-capture-image-1")
	app:frames(5)
	app:click("#quick-capture-remove-image-1")
	app:frames(10)
	expect(app:has("#quick-capture-images")).to_be(false)
	app:command("fixture.capture_image")
	app:frames(20)
	app:type("#quick-capture-input", "With a picture")
	app:key("Enter")
	app:frames(20)
	expect(calls(app)).to_contain("create:With a picture images=/uploads/assets/pictures/circles.png")
end)

test("Enter while a picture uploads saves once it is up, with the picture", function()
	local app = capture()
	app:command("fixture.capture_image_slow")
	app:type("#quick-capture-input", "Slow one")
	app:key("Enter")
	app:frames(5)
	expect(calls(app)).never.to_contain("create:Slow one")
	app:frames(60)
	expect(calls(app)).to_contain("create:Slow one images=/uploads/assets/pictures/wide.png")
	expect(shown(app, "#quick-capture")).to_be(false)
end)
