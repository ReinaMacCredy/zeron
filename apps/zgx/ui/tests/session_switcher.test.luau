local Pictures = require("../screens/shell/switcher_pictures")

test("a failed picture keeps what it had and takes no one's slot", function()
	local book = Pictures.Book(3)
	local function good(slot: string): string
		return `pic-{slot}`
	end
	local function fails(_: string): string?
		return nil
	end
	book.take("a", good)
	book.take("b", good)
	book.take("c", good)
	book.take("a", fails)
	expect(book.src("a")).to_be("pic-1")
	-- The window's full: a failed one evicts nothing, a good one the oldest.
	book.take("d", fails)
	expect(book.src("d")).to_be_nil()
	expect(book.src("a")).to_be("pic-1")
	book.take("d", good)
	expect(book.src("a")).to_be_nil()
	expect(book.src("d")).to_be("pic-1")
	expect(book.src("b")).to_be("pic-2")
	expect(book.src("c")).to_be("pic-3")
end)

test("no chat that failed its first picture shares a slot with a later one", function()
	local book = Pictures.Book(5)
	local slots: { [string]: string } = {}
	local function take(id: string, ok: boolean)
		book.take(id, function(slot: string): string?
			if ok then
				slots[id] = slot
				return slot
			end
			return nil
		end)
	end
	take("a", true)
	take("b", true)
	take("c", true)
	take("a", false)
	take("d", true)
	expect(slots.d ~= slots.c and slots.d ~= slots.a and slots.d ~= slots.b).to_be(true)
end)
