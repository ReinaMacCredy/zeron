-- Ctrl+Tab: the chats most recently used, held up while Control is, going to the one
-- highlighted as it's let go (crates/ui shell/switcher.rs). On the shell in
-- ui/shell_fixture.luau.

local function shell(): any
	local app = mount("shell_fixture.luau")
	app:resize(1400, 800)
	app:frames(30)
	return app
end

local function open(app: any, title: string)
	app:click(`#shell-sidebar >> role:button "{title}"`)
	app:frames(30)
end

-- Whether the cards are up. (A modal shut keeps what it built, hidden.)
local function up(app: any): boolean
	return app:state("shell_switcher_cards") ~= nil
end

local function route_has(app: any, id: string): boolean
	return tostring(app:state("shell_route_path")):find(id, 1, true) ~= nil
end

test("Ctrl+Tab held up lands on the chat before, and letting go goes there", function()
	local app = shell()
	open(app, "Fix the build")
	open(app, "Write the docs")
	open(app, "Tidy the tests")
	app:hold("ctrl")
	app:frames(3)
	app:command("shell.next_session")
	app:frames(10)
	expect(up(app)).to_be(true)
	expect(app:has("#switcher-card-a3")).to_be(true)
	expect(app:has("#switcher-card-a2")).to_be(true)
	-- Nothing's moved yet: only the cards.
	expect(route_has(app, "a3")).to_be(true)
	app:release()
	app:frames(30)
	expect(up(app)).to_be(false)
	expect(route_has(app, "a2")).to_be(true)
	expect(app:error()).to_be_nil()
end)

test("each press moves on in the order used, Shift back, as the keys come to it", function()
	local app = shell()
	open(app, "Fix the build")
	open(app, "Write the docs")
	open(app, "Tidy the tests")
	app:hold("ctrl")
	app:frames(3)
	app:command("shell.next_session")
	app:frames(5)
	expect(app:state("shell_switcher_hi")).to_be(2)
	app:key("ctrl+tab")
	app:frames(5)
	expect(app:state("shell_switcher_hi")).to_be(3)
	app:key("ctrl+tab")
	app:frames(5)
	expect(app:state("shell_switcher_hi")).to_be(4)
	app:key("ctrl+shift+tab")
	app:frames(5)
	expect(app:state("shell_switcher_hi")).to_be(3)
	app:release()
	app:frames(30)
	-- (a3 showing, then a2, then a1.)
	expect(route_has(app, "a1")).to_be(true)
	expect(app:error()).to_be_nil()
end)

