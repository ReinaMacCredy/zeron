test("on a plugin's page it goes home first, as Zeron's, so the first press lands on the latest chat", function()
	local app = shell()
	open(app, "Fix the build")
	open(app, "Write the docs")
	app:set_state("plugins.pages", { { plugin = "github", id = "pulls", title = "Pull requests", icon = "pull-request" } })
	app:frames(10)
	app:click("#open-pull-requests")
	app:frames(20)
	expect(app:state("shell_route_path")).to_be("/plugin/github/pulls")
	app:hold("ctrl")
	app:frames(3)
	app:command("shell.next_session")
	app:frames(10)
	expect(app:state("shell_switcher_cards")[1]).to_be("draft")
	expect(app:state("shell_switcher_cards")[2]).to_be("a2")
	expect(app:state("shell_switcher_hi")).to_be(2)
	app:release()
	app:frames(30)
	expect(route_has(app, "a2")).to_be(true)
	expect(app:error()).to_be_nil()
end)

