test("set to cycle the tabs, a held draft's tab is one of them, after the last", function()
	local app = shell()
	app:set_state("shell_switcher_cycles_tabs", true)
	app:set_state("chat.composer.text", "Half a thought")
	app:frames(10)
	open(app, "Fix the build")
	open(app, "Write the docs")
	open(app, "Tidy the tests")
	expect(app:has("#session-tab-draft")).to_be(true)
	app:command("shell.next_session")
	app:frames(20)
	expect(app:state("shell_route_path")).to_be("/")
	app:command("shell.next_session")
	app:frames(20)
	expect(route_has(app, "a1")).to_be(true)
	app:command("shell.previous_session")
	app:frames(20)
	expect(app:state("shell_route_path")).to_be("/")
	expect(app:error()).to_be_nil()
end)

test("a pointer at rest under the cards leaves the highlight; moving it takes it", function()
	local app = shell()
	open(app, "Fix the build")
	open(app, "Write the docs")
	open(app, "Tidy the tests")
	app:hold("ctrl")
	app:frames(3)
	app:command("shell.next_session")
	app:frames(10)
	app:hover("#switcher-card-a1")
	app:frames(3)
	expect(app:state("shell_switcher_hi")).to_be(3)
	app:key("Escape")
	app:frames(20)
	-- The pointer stays where the cards come up again.
	app:command("shell.next_session")
	app:frames(20)
	expect(app:state("shell_switcher_hi")).to_be(2)
	app:hover("#switcher-card-a3")
	app:frames(3)
	expect(app:state("shell_switcher_hi")).to_be(1)
	expect(app:error()).to_be_nil()
end)

