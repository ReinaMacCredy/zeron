local function at_state(app: any): any
	return app:state("shell_add_project_at")
end
local function release(app: any)
	app:command("fixture.release")
	app:frames(20)
end
local function at_work(app: any)
	app:command("shell.new_project")
	app:frames(20)
	choose(app, "MacBook Pro")
	choose(app, "Work")
	expect(app:wait(`{LIST} >> role:option "atlas"`, { timeout_ms = 2000 })).to_be(true)
end

test("a folder answering after it was left moves nothing", function()
