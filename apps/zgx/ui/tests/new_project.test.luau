-- New project open on `device`'s Home.
local function at_home(app: any, device: string)
	app:command("shell.new_project")
	app:frames(20)
	choose(app, device)
	choose(app, "Home")
	expect(app:wait(`{LIST} >> role:option "code"`, { timeout_ms = 2000 })).to_be(true)
end

local PATH = "#project-path-input"

test("⌘L types the folder's path in the trail, from home as ~, and Escape puts the trail back", function()
	local app = open()
	at_home(app, "MacBook Pro")
	app:key("cmd+l")
	app:frames(10)
	expect(app:text(PATH)).to_be("~/")
	app:key("Escape")
	app:frames(10)
	expect(app:has(PATH)).to_be(false)
	expect(shown(app)).to_be(true)
	into(app, "code")
	app:key("cmd+l")
	app:frames(10)
	expect(app:text(PATH)).to_be("~/code/")
end)

test("a path typed in the trail opens on Enter, says why it can't under the field, and keeps the folder listed", function()
	local app = open()
	at_home(app, "MacBook Pro")
	app:key("cmd+l")
	app:frames(10)
	app:fill(PATH, "/gone")
	app:key("Enter")
	expect(app:wait('#project-path-error >> ~"No folder at /gone"', { timeout_ms = 2000 })).to_be(true)
	expect(app:has(`{LIST} >> role:option "code"`)).to_be(true)
	expect(app:text(PATH)).to_be("/gone")
	app:fill(PATH, "/work")
	app:frames(5)
	expect(app:has("#project-path-error")).to_be(false)
	app:key("Enter")
	expect(app:wait(`{LIST} >> role:option "atlas"`, { timeout_ms = 2000 })).to_be(true)
	expect(app:has(PATH)).to_be(false)
end)

