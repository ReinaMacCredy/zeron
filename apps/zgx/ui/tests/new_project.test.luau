test("a click chooses a folder's row, a double click goes in, and the pointer crossing rows leaves the highlight", function()
	local app = open()
	at_home(app, "MacBook Pro")
	local notes = `{LIST} >> role:option "notes"`
	app:hover(notes)
	app:frames(5)
	app:key("Enter")
	app:frames(20)
	expect(calls(app)).to_contain("folders:mac:/Users/me/code")
	expect(calls(app)).never.to_contain("folders:mac:/Users/me/notes")
	app:key("ArrowLeft")
	expect(app:wait(notes, { timeout_ms = 2000 })).to_be(true)
	app:click(notes)
	app:frames(5)
	expect(calls(app)).never.to_contain("folders:mac:/Users/me/notes")
	app:key("Enter")
	expect(app:wait(`{LIST} >> role:option "This folder"`, { timeout_ms = 2000 })).to_be(true)
	expect(calls(app)).to_contain("folders:mac:/Users/me/notes")
	app:key("ArrowLeft")
	expect(app:wait(notes, { timeout_ms = 2000 })).to_be(true)
	app:double_click(`{LIST} >> role:option "code"`)
	app:frames(20)
	expect(app:has(notes)).to_be(false)
end)

