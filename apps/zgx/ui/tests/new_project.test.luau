test("the rail lists Pinned, Recent and Locations; a row's Pin puts it there, Unpin takes it off; each goes to its folder", function()
	local app = open()
	at_home(app, "MacBook Pro")
	local rail = "#project-rail"
	expect(app:has(`{rail} >> "Pinned"`)).to_be(false)
	expect(app:has(`{rail} >> "Recent"`)).to_be(true)
	expect(app:has(`{rail} >> role:button "work"`)).to_be(true)
	expect(app:has(`{rail} >> role:button "Home"`)).to_be(true)
	expect(app:has(`{rail} >> role:button "Work"`)).to_be(true)
	app:hover(`{LIST} >> role:option "code"`)
	app:frames(5)
	app:click(`{LIST} >> role:option "code" >> role:button "Pin"`)
	app:frames(5)
	expect(app:has(`{rail} >> "Pinned"`)).to_be(true)
	expect(app:has(`{rail} >> role:button "code"`)).to_be(true)
	expect(app:state("shell_add_project_pins").mac[1]).to_be("/Users/me/code")
	expect(app:has(`{LIST} >> role:option "code" >> role:button "Unpin"`)).to_be(true)
	app:click(`{rail} >> role:button "code"`)
	expect(app:wait(`{LIST} >> role:option "zephyr"`, { timeout_ms = 2000 })).to_be(true)
	expect(calls(app)).to_contain("folders:mac:/Users/me/code")
	app:click(`{rail} >> role:button "Work"`)
	expect(app:wait(`{LIST} >> role:option "atlas"`, { timeout_ms = 2000 })).to_be(true)
	app:click(`{rail} >> role:button "code"`)
	expect(app:wait(`{LIST} >> role:option "zephyr"`, { timeout_ms = 2000 })).to_be(true)
	app:hover(`{LIST} >> role:option "This folder"`)
	app:frames(5)
	app:click(`{LIST} >> role:option "This folder" >> role:button "Unpin"`)
	app:frames(5)
	expect(app:has(`{rail} >> "Pinned"`)).to_be(false)
end)

