local function open(): any
	local app = mount("md_file_cards_fixture.luau")
	app:resize(700, 1000)
	app:frames(20)
	expect(app:error()).to_be_nil()
	expect(app:wait(".md-file-card", { timeout_ms = 3000 })).to_be(true)
	app:frames(5)
	return app
end

local function cards(app: any): number
	local n = 0
	for label in string.gmatch(app:tree("#reply"), 'button "([^"]+)" ') do
		if not (string.find(label, "^Quick look ") or string.find(label, "^Open ") or label == "Reveal in Finder" or label == "Close preview") then
			n += 1
		end
	end
	return n
end

local function peek(app: any, name: string)
	app:hover(`role:button "{name}"`)
	app:frames(15)
	app:click(`role:button "Quick look {name}"`)
end

local REPORT = 'role:button "checkout-latency-report.md"'
local CSV = 'role:button "checkout-latency.csv"'

test("file cards: a paragraph or list naming only listed files is cards, those one after another in one list; prose, or a dotted word the folder doesn't list, stays words", function()
	local app = open()
	expect(cards(app)).to_be(4)
	for _, name in { "checkout-latency-report.md", "checkout-latency.csv", "chart.png", "notes.txt" } do
		expect(app:has(`role:button "{name}"`)).to_be(true)
	end
	expect(app:has('"Markdown · 4 KB"')).to_be(true)
	expect(app:has('.md-file-head >> "4 files"')).to_be(true)
	expect(app:has('"string.find"')).to_be(true)
	expect(app:has('"notes.txt missing.md"')).to_be(true)
	expect(app:has('"See checkout-latency-report.md for the rest."')).to_be(true)
	expect(app:has('role:link "checkout-latency-report.md"')).to_be(false)
	local lists = 0
	for _, c in app:state("test_calls") do
		if c == "list:" then
			lists += 1
		end
	end
	expect(lists).to_be(1)
end)

test("file cards: a press opens the file in the panel; its eye opens the file's head under the list, Markdown as it reads, another's takes its place, the open one's closes it", function()
	local app = open()
	app:click(REPORT)
	app:frames(10)
	expect(app:state("test_calls")).to_contain("open:checkout-latency-report.md")
	expect(app:has(".md-file-preview")).to_be(false)
	peek(app, "checkout-latency-report.md")
	expect(app:wait('.md-file-preview >> "Checkout latency, week 47"', { timeout_ms = 3000 })).to_be(true)
	expect(app:tree(".md-file-preview")).to_contain('heading "Checkout latency, week 47"')
	expect(app:has('.md-file-preview >> "# Checkout latency, week 47"')).to_be(false)
	peek(app, "checkout-latency.csv")
	expect(app:wait('"165 more lines"', { timeout_ms = 3000 })).to_be(true)
	expect(app:has('.md-file-preview >> "p95"')).to_be(true)
	expect(app:has('.md-file-preview >> "2026-11-18"')).to_be(true)
	expect(app:has('.md-file-preview >> "Checkout latency, week 47"')).to_be(false)
	app:frames(30)
	app:click('.md-file-preview >> role:button "Open in right pane"')
	app:click('.md-file-head >> role:button "Reveal in Finder"')
	app:frames(10)
	local calls = app:state("test_calls")
	expect(calls).to_contain("open:checkout-latency.csv")
	expect(calls).to_contain("reveal:s1:/work/atlas:checkout-latency-report.md")
	app:right_click(CSV)
	app:frames(20)
	app:click('role:menuitem "Reveal in Finder"')
	app:frames(20)
	expect(app:state("test_calls")).to_contain("menu-reveal:checkout-latency.csv")
	peek(app, "checkout-latency.csv")
	expect(app:wait(".md-file-preview", { gone = true, timeout_ms = 3000 })).to_be(true)
end)

test("file cards: one whose file went away since it showed says so, dimmed, and a press does nothing more", function()
	local app = open()
	app:set_state("test_gone", { "checkout-latency.csv" })
	app:click(CSV)
	expect(app:wait('"No longer on this machine"', { timeout_ms = 3000 })).to_be(true)
	app:frames(30)
	expect(app:has(".md-file-preview")).to_be(false)
	expect(cards(app)).to_be(4)
	local before = #app:state("test_calls")
	app:click(CSV)
	app:frames(30)
	expect(#app:state("test_calls")).to_be(before)
end)

test("file cards: while the reply is being written its files stay words, and turn to cards once it ends", function()
	local app = open()
	app:set_state("test_live", true)
	app:set_state("test_reply", app:state("test_reply") .. "\n\nnotes.txt checkout-latency.csv")
	app:frames(30)
	expect(app:has('"notes.txt checkout-latency.csv"')).to_be(true)
	expect(cards(app)).to_be(4)
	app:set_state("test_live", false)
	app:frames(30)
	expect(app:wait('"notes.txt checkout-latency.csv"', { gone = true, timeout_ms = 3000 })).to_be(true)
	expect(cards(app)).to_be(6)
end)

test("file cards: a file named before it was written turns to a card once its folder lists it", function()
	local app = open()
	expect(app:has('"later.md"')).to_be(true)
	app:set_state("test_extra", { "later.md" })
	app:wait('"never shown, only waited past"', { timeout_ms = 6000 })
	app:set_state("test_reply", app:state("test_reply") .. "\n\nlater.md checkout-latency.csv")
	expect(app:wait('role:button "later.md"', { timeout_ms = 3000 })).to_be(true)
	app:frames(10)
	local _, later = string.gsub(app:tree("#reply"), 'button "later.md"', "")
	expect(later).to_be(2)
	expect(string.find(app:tree("#reply"), 'text "later.md"', 1, true)).to_be_nil()
end)

test("file cards: a file outside the chat's folder, named by its whole path, is a card that opens and previews; no Reveal, no picture read, and one that isn't there stays words", function()
	local app = open()
	app:set_state("test_reply", app:state("test_reply") .. "\n\n/tmp/scratch/shot.png\n/tmp/scratch/findings.md\n\n/tmp/scratch/missing.md")
	expect(app:wait('role:button "shot.png"', { timeout_ms = 3000 })).to_be(true)
	expect(app:wait('role:button "findings.md"', { timeout_ms = 3000 })).to_be(true)
	expect(app:has('"PNG · 51 KB"')).to_be(true)
	app:frames(30)
	expect(app:has('role:button "missing.md"')).to_be(false)
	expect(app:has('"/tmp/scratch/missing.md"')).to_be(true)
	app:click('role:button "findings.md"')
	app:frames(10)
	expect(app:state("test_calls")).to_contain("open:/tmp/scratch/findings.md")
	peek(app, "findings.md")
	expect(app:wait('.md-file-preview >> ~"All good."', { timeout_ms = 3000 })).to_be(true)
	peek(app, "shot.png")
	expect(app:wait('.md-file-preview >> "More in the Files panel"', { timeout_ms = 3000 })).to_be(true)
	app:frames(30)
	local _, reveals = string.gsub(app:tree("#reply"), 'button "Reveal in Finder"', "")
	expect(reveals).to_be(1)
	app:click('.md-file-preview >> role:button "Open in right pane"')
	app:frames(10)
	expect(app:state("test_calls")).to_contain("open:/tmp/scratch/shot.png")
	app:set_state("test_gone", { "/tmp/scratch/shot.png" })
	app:click('role:button "shot.png"')
	expect(app:wait('"No longer on this machine"', { timeout_ms = 3000 })).to_be(true)
end)

test("file cards: a whole path with a space in it is one file, in code or in plain words, once in the list its paragraphs share; any kind of file is a card", function()
	local app = open()
	app:set_state("test_reply", app:state("test_reply") .. "\n\n`/tmp/scratch/My Notes/plan.md`\n/tmp/scratch/page.html\n\n/tmp/scratch/My Notes/plan.md\n\n/tmp/scratch/shot.png is the capture.")
	expect(app:wait('"HTML · 53 KB"', { timeout_ms = 3000 })).to_be(true)
	local _, plans = string.gsub(app:tree("#reply"), 'button "plan.md"', "")
	expect(plans).to_be(1)
	expect(app:has('.md-file-head >> "2 files"')).to_be(true)
	expect(app:has('"/tmp/scratch/shot.png is the capture."')).to_be(true)
	peek(app, "plan.md")
	expect(app:wait('.md-file-preview >> ~"Plan: ship."', { timeout_ms = 3000 })).to_be(true)
	app:frames(30)
	app:click('.md-file-preview >> role:button "Close preview"')
	expect(app:wait(".md-file-preview", { gone = true, timeout_ms = 3000 })).to_be(true)
	app:click('role:button "plan.md"')
	app:frames(10)
	expect(app:state("test_calls")).to_contain("open:/tmp/scratch/My Notes/plan.md")
end)

test("file cards: an HTML file's line has Open in browser beside its eye, which opens it in its app; one outside the chat's folder has none", function()
	local app = open()
	app:set_state("test_reply", app:state("test_reply") .. "\n\ndashboard.html\n\n/tmp/scratch/page.html")
	expect(app:wait('role:button "dashboard.html"', { timeout_ms = 3000 })).to_be(true)
	expect(app:wait('role:button "page.html"', { timeout_ms = 3000 })).to_be(true)
	app:hover('role:button "dashboard.html"')
	app:frames(15)
	app:click('role:button "Open dashboard.html in the browser"')
	app:frames(10)
	expect(app:state("test_calls")).to_contain("browse:s1:/work/atlas:dashboard.html")
	expect(app:has('role:button "Open page.html in the browser"')).to_be(false)
	expect(app:has('role:button "Open notes.txt in the browser"')).to_be(false)
end)
