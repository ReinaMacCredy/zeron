-- The model picker answers the keys as Zeron's does, on ui/picker_fixture.luau:
-- the panel's arrows, Fast, Tab, typing; the list's stars, ⌘N and Tab; the full
-- layout's way into its tray; and what shows in which order.

local function settle(app: any)
	app:frames(30)
end
local function opened(app: any)
	app:resize(700, 760)
	settle(app)
	app:click('role:button "Model"')
	settle(app)
end
local function shows(app: any, target: string): boolean
	for line in app:tree():gmatch("[^\n]+") do
		if line:find(target, 1, true) and not line:find(" hidden", 1, true) then
			return true
		end
	end
	return false
end
local function rows(app: any): { string }
	local out: { string } = {}
	for line in app:tree():gmatch("[^\n]+") do
		local name = line:match(' option "([^"]*)"')
		if name and not line:find(" hidden", 1, true) then
			table.insert(out, name)
		end
	end
	return out
end
local COMPACT = "ds/model_picker.luau::model_picker_compact"

test("on the panel, ←/→ and Home/End set the level, F Fast, each without focusing anything", function()
	local app = mount("picker_fixture.luau")
	app:set_state("test_picker_model", "opus")
	opened(app)
	expect(app:state("test_picker_effort")).to_be("medium")
	app:key("ArrowLeft")
	settle(app)
	expect(app:state("test_picker_effort")).to_be("low")
	app:key("End")
	settle(app)
	expect(app:state("test_picker_effort")).to_be("high")
	app:key("Home")
	settle(app)
	expect(app:state("test_picker_effort")).to_be("low")
	app:key("ArrowRight")
	settle(app)
	expect(app:state("test_picker_effort")).to_be("medium")
	expect(app:state("test_picker_fast")).to_be(false)
	app:key("f")
	settle(app)
	expect(app:state("test_picker_fast")).to_be(true)
	expect(shows(app, "#model-picker-title")).to_be(true)
	expect(app:has("#model-picker-chip-fast")).to_be(true)
	app:key("f")
	settle(app)
	expect(app:state("test_picker_fast")).to_be(false)
end)

test("on the panel, ↓ goes to the list beside the model, Enter to it, and typing searches", function()
	local app = mount("picker_fixture.luau")
	opened(app)
	app:key("ArrowDown")
	settle(app)
	expect(shows(app, 'textbox "Search"')).to_be(true)
	-- Enter takes the row beside Sonnet, the model after it.
	app:key("Enter")
	settle(app)
	expect(app:state("test_picker_model")).to_be("opus-1m")
	expect(shows(app, "#model-picker-title")).to_be(true)
	app:key("Enter")
	settle(app)
	expect(#rows(app) > 3).to_be(true)
	app:key("Escape")
	settle(app)
	expect(shows(app, "#model-picker-title")).to_be(true)
	-- A letter opens the list, searching for it.
	app:key("g")
	settle(app)
	expect(rows(app)[1]).to_be("GPT")
	expect(app:error()).to_be_nil()
end)

test("Tab on a new chat's panel moves to the next agent's last model; on a chat it only browses", function()
	local app = mount("picker_fixture.luau")
	opened(app)
	app:key("Tab")
	settle(app)
	expect(app:state("test_picker_model")).to_be("gpt")
	expect(shows(app, "#model-picker-title")).to_be(true)
	-- Back and on: Codex's, as last used.
	app:key("Tab")
	settle(app)
	expect(app:state("test_picker_model")).to_be("adaptive")
	app:key("Escape")
	settle(app)
	app:set_state("test_picker_committed", true)
	app:click('role:button "Model"')
	settle(app)
	app:key("Tab")
	settle(app)
	expect(app:state("test_picker_model")).to_be("adaptive")
	expect(#rows(app) > 3).to_be(true)
end)

test("a chat's model and level, only seen, are not what the next new chat opens on; a new chat's pick is", function()
	local app = mount("picker_fixture.luau")
	-- A chat running Mini, then one on GPT at Minimal: seen, never picked.
	app:set_state("test_picker_committed", true)
	app:set_state("test_picker_model", "mini")
	settle(app)
	app:set_state("test_picker_model", "gpt")
	app:set_state("test_picker_effort", "minimal")
	settle(app)
	-- A new chat on Sonnet at Medium.
	app:set_state("test_picker_committed", false)
	app:set_state("test_picker_model", "sonnet")
	app:set_state("test_picker_effort", "medium")
	settle(app)
	opened(app)
	app:click("#model-picker-title")
	settle(app)
	app:click('role:option "GPT"')
	settle(app)
	expect(app:state("test_picker_model")).to_be("gpt")
	expect(app:state("test_picker_effort")).to_be("medium")
	-- Its level picked here, and Mini picked: those are kept.
	app:key("ArrowLeft")
	settle(app)
	expect(app:state("test_picker_effort")).to_be("low")
	app:click("#model-picker-title")
	settle(app)
	app:click('role:option "Sonnet"')
	settle(app)
	app:click("#model-picker-title")
	settle(app)
	app:click('role:option "GPT"')
	settle(app)
	expect(app:state("test_picker_effort")).to_be("low")
	local last = app:state("ds/model_picker.luau::model_last_used") or {}
	expect(last.codex).to_be("gpt")
	expect(last.claude).to_be("sonnet")
end)

test("the list: stars float to the top, ⌘⇧F stars the highlighted row, ⌘N picks", function()
	local app = mount("picker_fixture.luau")
	opened(app)
	app:click("#model-picker-title")
	settle(app)
	expect(rows(app)[1]).to_be("Sonnet")
	app:click('role:option "GPT"')
	settle(app)
	expect(app:state("test_picker_model")).to_be("gpt")
	app:click("#model-picker-title")
	settle(app)
	-- The highlight is on GPT: starred, it leads, and nothing's picked.
	app:key("cmd+shift+f")
	settle(app)
	expect((app:state("test_picker_favorites") or {}).gpt).to_be(true)
	expect(rows(app)[1]).to_be("GPT")
	expect(app:state("test_picker_model")).to_be("gpt")
	-- ⌘3: the third row as it stands.
	local third = rows(app)[3]
	app:key("cmd+3")
	settle(app)
	expect(app:state("test_picker_model") ~= "gpt").to_be(true)
	expect(third ~= "GPT").to_be(true)
	app:key("Tab")
	settle(app)
	expect(app:error()).to_be_nil()
end)

test("a search ranks a prefix, then within the name, then the description", function()
	local app = mount("picker_fixture.luau")
	opened(app)
	app:click("#model-picker-title")
	settle(app)
	app:type('role:textbox "Search"', "o")
	settle(app)
	-- The Opuses start with it, Sonnet holds it, Mini only by its description.
	local found = rows(app)
	expect(found[1]).to_be("Opus 1M")
	expect(found[2]).to_be("Opus")
	expect((table.find(found, "Sonnet") or 0) > 2).to_be(true)
	expect(found[#found]).to_be("Mini")
	expect(table.find(found, "GPT")).to_be(nil)
end)

test("the full layout is kept, its arrows go on into the tray, and ←/→ step there", function()
	local app = mount("picker_fixture.luau")
	app:set_state("test_picker_committed", true)
	opened(app)
	app:click("#model-picker-layout")
	settle(app)
	expect(app:state(COMPACT)).to_be(false)
	expect(app:has('role:tab "Codex"')).to_be(true)
	-- From the last row, on into the slider, where ←/→ step the level.
	app:key("ArrowUp")
	app:key("End")
	local n = #rows(app)
	for _ = 1, n do
		app:key("ArrowDown")
		app:frames(2)
	end
	settle(app)
	local before = app:state("test_picker_effort")
	app:key("ArrowRight")
	settle(app)
	app:key("ArrowLeft")
	settle(app)
	expect(app:state("test_picker_effort") ~= nil).to_be(true)
	expect(before ~= nil).to_be(true)
	-- Tab: the next tab, browsing.
	app:key("Tab")
	settle(app)
	expect(app:state("test_picker_model")).to_be("sonnet")
	app:click("#model-picker-layout")
	settle(app)
	expect(app:state(COMPACT)).to_be(true)
	expect(app:error()).to_be_nil()
end)

test("the context card: long context and its stops write one pick, the readout following", function()
	local app = mount("picker_fixture.luau")
	app:set_state("test_picker_model", "opus-1m")
	app:set_state("test_picker_context", 202000)
	opened(app)
	expect(app:has('#model-picker-context-readout >> ~"1M window"')).to_be(true)
	expect(app:has('#model-picker-context-readout >> ~"compacts at ~967K"')).to_be(true)
	expect(app:has('~"Switching to 200K compacts this chat (~202K in use)"')).to_be(true)
	app:click('role:button "600K"')
	settle(app)
	expect((app:state("test_picker_options") or {}).autoCompact).to_be("600k")
	expect(app:has('~"compacts at ~567K"')).to_be(true)
	app:click("#model-picker-200k")
	settle(app)
	expect((app:state("test_picker_options") or {}).contextWindow).to_be("200k")
	expect(app:has('~"200K window"')).to_be(true)
	expect(app:has('~"compacts at ~167K"')).to_be(true)
	expect(app:has('~"the next message compacts it"')).to_be(true)
	app:click("#model-picker-long")
	settle(app)
	expect((app:state("test_picker_options") or {}).contextWindow).to_be(nil)
	expect((app:state("test_picker_options") or {}).autoCompact).to_be("600k")
	expect(app:has('~"compacts at ~567K"')).to_be(true)
	expect(app:error()).to_be_nil()
end)

test("the context card: a limit chip sets where the chat compacts, then the track moves only Zeron's ask point", function()
	local app = mount("picker_fixture.luau")
	app:set_state("test_picker_model", "opus-1m")
	opened(app)
	app:click('role:button "600K"')
	settle(app)
	expect(app:has("#model-picker-extend-auto")).to_be(true)
	app:click("#model-picker-extend-800k")
	settle(app)
	local picks = app:state("test_picker_options") or {}
	expect(picks.autoCompact).to_be("800k")
	expect(picks.askAt).to_be("600k")
	expect(app:has('#model-picker-context-readout >> ~"asks at ~567K"')).to_be(true)
	expect(app:has('#model-picker-context-readout >> ~"compacts at ~767K"')).to_be(true)
	expect(app:has('#model-picker-context-notice >> ~"this chat restarts"')).to_be(true)
	app:click('role:button "400K"')
	settle(app)
	picks = app:state("test_picker_options") or {}
	expect(picks.askAt).to_be("400k")
	expect(picks.autoCompact).to_be("800k")
	expect(app:has('#model-picker-context-notice >> ~"Applies now, no restart."')).to_be(true)
	app:set_state("test_picker_context", 380000)
	app:wait(2500)
	settle(app)
	expect(app:has('#model-picker-context-notice >> ~"went on past ~367K · asks again at ~567K"')).to_be(true)
	app:click("#model-picker-extend-off")
	settle(app)
	picks = app:state("test_picker_options") or {}
	expect(picks.askAt).to_be(nil)
	expect(picks.autoCompact).to_be("400k")
	expect(app:has('#model-picker-context-readout >> ~"asks at"')).to_be(false)
	expect(app:has('#model-picker-context-readout >> ~"compacts at ~367K"')).to_be(true)
	expect(app:error()).to_be_nil()
end)

test("a take of the pick holds it: the model doesn't change", function()
	local app = mount("picker_fixture.luau")
	app:set_state("test_picker_asking", true)
	opened(app)
	app:click("#model-picker-title")
	settle(app)
	app:click('role:option "GPT"')
	settle(app)
	expect(app:state("test_picker_taken")).to_be("gpt")
	expect(app:state("test_picker_model")).to_be("sonnet")
end)
