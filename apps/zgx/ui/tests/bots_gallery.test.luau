local function open(): any
	local app = mount("bots_fixture.luau")
	app:resize(1200, 800)
	app:frames(30)
	app:click("#rail-bots")
	app:frames(30)
	app:click("#bots-more")
	app:frames(30)
	return app
end
local function calls(app: any): string
	return app:state("bots_calls") :: string
end
local function dialog_up(app: any): boolean
	return app:has("#bots-create-card") and not string.find(app:tree("#bots-create-card"), "hidden", 1, true)
end

test("the gallery lists your Bots and the archived ones apart, and filters by name as you type", function()
	local app = open()
	local tabs = app:tree('role:tablist "Bots"')
	expect(tabs).to_contain('tab "From you 4"')
	expect(tabs).to_contain('tab "Archived 1"')
	local grid = app:tree("#bots-grid")
	expect(grid).to_contain('#bots-card-k1 button "Release keeper"')
	expect(grid).to_contain("#bots-card-create")
	expect(grid).never.to_contain("Old helper")
	app:type("#bots-search", "DOCS")
	app:frames(20)
	grid = app:tree("#bots-grid")
	expect(grid).to_contain('#bots-card-k2 button "Docs writer"')
	expect(grid).never.to_contain("Release keeper")
	app:fill("#bots-search", "zzz")
	app:frames(20)
	expect(app:has("#bots-none")).to_be(true)
	expect(app:has("#bots-card-create")).to_be(true)
	app:fill("#bots-search", "")
	app:click("#bots-tab-archived")
	app:frames(20)
	grid = app:tree("#bots-grid")
	expect(grid).to_contain('#bots-card-k5 button "Old helper"')
	expect(grid).never.to_contain("#bots-card-create")
	app:click("#bots-tab-you")
	app:frames(20)
	app:click("#bots-card-k3")
	app:frames(30)
	expect(app:state("shell_route_path")).to_be("/session/b1")
end)

test("Create Bot: a template carries its name and look to step 2, Back keeps the choice, Create makes it first among the unpinned and opens its chat", function()
	local app = open()
	app:click("#bots-create")
	app:frames(40)
	expect(dialog_up(app)).to_be(true)
	expect(app:text("#bots-create-title")).to_be("What’s your goal?")
	app:type("#bots-create-search", "docs")
	app:frames(20)
	expect(app:has("#bots-create-template-docs")).to_be(true)
	expect(app:has("#bots-create-template-triage")).to_be(false)
	app:click("#bots-create-template-docs")
	app:click("#bots-create-next")
	app:frames(40)
	expect(app:text("#bots-create-title")).to_be("Customize your Bot")
	expect(app:text("#bots-create-name")).to_be("Docs writer")
	app:click("#bots-create-back")
	app:frames(40)
	expect(app:tree("#bots-create-preview")).to_contain('heading "Docs writer"')
	app:click("#bots-create-next")
	app:frames(40)
	app:fill("#bots-create-name", "Guide keeper")
	app:click("#bots-create-glyph-star")
	app:click("#bots-create-frame-circle")
	app:click("#bots-create-color-red")
	app:click("#bots-create-make")
	app:frames(40)
	expect(calls(app)).to_contain("create:Guide keeper:docs:star/circle/red/none")
	expect(dialog_up(app)).to_be(false)
	expect(app:state("shell_route_path")).to_be("/session/c1")
	local panel = app:tree("#bots-panel")
	local new, old = string.find(panel, "#bot-row-n1", 1, true), string.find(panel, "#bot-row-k3", 1, true)
	expect(new ~= nil and old ~= nil and new < old).to_be(true)
end)

test("Create Bot closes on Escape and on its close button, opens from the panel too, and a blank name makes a New Bot", function()
	local app = open()
	app:click("#bots-create")
	app:frames(40)
	app:key("Escape")
	app:frames(40)
	expect(dialog_up(app)).to_be(false)
	app:click("#bots-create")
	app:frames(40)
	app:click("#bots-create-close")
	app:frames(40)
	expect(dialog_up(app)).to_be(false)
	app:click("#bots-add")
	app:frames(20)
	app:click("#bots-add-create")
	app:frames(40)
	expect(dialog_up(app)).to_be(true)
	app:click("#bots-create-next")
	app:frames(40)
	app:click("#bots-create-make")
	app:frames(40)
	expect(calls(app)).to_contain("create:New Bot:scratch:bot/squircle/violet/none")
end)

test("Create Bot: a chosen image becomes the avatar Create sends, one too big says so, and a glyph picked after takes its place", function()
	local app = open()
	app:click("#bots-create")
	app:frames(40)
	app:click("#bots-create-next")
	app:frames(40)
	app:click("#bots-create-tab-upload")
	app:frames(20)
	app:copy_file("assets/favicons/zeron.png", "big.png")
	app:pick({ "big.png" })
	app:click("#bots-create-choose")
	app:frames(30)
	expect(app:text("#bots-create-said")).to_contain("5 MB")
	app:copy_file("assets/favicons/zeron.png", "face.png")
	app:pick({ "face.png" })
	app:click("#bots-create-choose")
	app:frames(30)
	expect(calls(app)).to_contain("image:face.png")
	expect(app:has("#bots-create-said")).to_be(false)
	app:click("#bots-create-make")
	app:frames(40)
	expect(calls(app)).to_contain("create:New Bot:scratch:bot/squircle/violet/image")
	app:click("#bots-more")
	app:frames(30)
	app:click("#bots-create")
	app:frames(40)
	app:click("#bots-create-next")
	app:frames(40)
	app:click("#bots-create-tab-upload")
	app:frames(20)
	app:pick({ "face.png" })
	app:click("#bots-create-choose")
	app:frames(30)
	app:click("#bots-create-tab-icons")
	app:frames(20)
	app:click("#bots-create-glyph-star")
	app:click("#bots-create-make")
	app:frames(40)
	expect(calls(app)).to_contain("create:New Bot:scratch:star/squircle/violet/none")
end)
