	expect(app:has("#threads-history-row-c1")).to_be(false)
	app:click("#threads-history-plan-1-head")
	app:frames(30)
	expect(app:tree("#threads-history-plan-1")).to_contain("Port the parser first")
	expect(app:has("#threads-history-done-c2")).to_be(false)
	app:click("#threads-history-done-c1")
	app:frames(10)
	expect(calls(app)).to_contain("threads.mark:c1:done")
	expect(app:tree("#threads-history-row-c3")).to_contain("Not run")
	expect(app:has("#threads-history-done-c3")).to_be(false)
	expect(app:has("#threads-history-carry-c1")).to_be(false)
	app:click("#threads-history-carry-c3")
	app:frames(10)
	expect(calls(app)).to_contain("threads.carry:c3:")
	expect(tabs(app)[1].thread).to_be(nil)
	app:click("#threads-history-row-c2")
	app:frames(30)
	expect(tabs(app)[1].thread).to_be("dg-old2")
	expect(app:tree("#threads-thread")).to_contain("Retire the old docs")
	app:click("#threads-back")
	app:frames(30)
	expect(app:has("#threads-history")).to_be(true)
	app:click("#threads-history-back")
	app:frames(30)
	expect(app:has("#threads-list")).to_be(true)
	expect(app:error()).to_be(nil)
end)

