local function node_of(app: any, sel: string): string?
	return string.match(app:tree(sel), "^@(%d+)")
end

test("threads: a plan step's delegate and handback draw no card while the plan card shows; compacted away, they draw as before", function()
	local app = seeded()
	app:command("show_plan")
	app:frames(30)
	app:command("plan_run")
	app:frames(30)
	expect(app:count(".plan-steps-started")).to_be(1)
	expect(app:tree(".plan-steps-started")).to_contain("Started 2 steps")
	expect(app:count(".thread-card")).to_be(1)
	expect(app:has("#card-h-review")).to_be(false)
	expect(app:tree("#card-p-review")).to_contain("A note from the export thread.")
	expect(app:has("#card-p-fail")).to_be(true)
	app:click("#plan-card-step-s1-row")
	app:frames(30)
	local said = app:tree("#plan-card-step-s1-result")
	expect(said).to_contain("The export works for orders and refunds.")
	expect(said).never.to_contain("stepId")
	expect(said).never.to_contain("read_thread")
	app:command("plan_forget")
	app:frames(30)
	expect(app:has("#plan-card")).to_be(false)
	expect(app:count(".plan-steps-started")).to_be(0)
	expect(app:count(".thread-card")).to_be(3)
	local card = app:tree("#card-p-review")
	expect(card).to_contain("The export works")
	expect(card).never.to_contain("stepId")
	expect(card).never.to_contain("Read it with read_thread")
	expect(app:error()).to_be(nil)
end)

