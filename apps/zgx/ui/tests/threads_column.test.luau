test("threads: an earlier plan's write draws its card closed over its step's hidden handback; the newest is Plan 2; that write gone, the handback draws as before", function()
	local app = seeded()
	app:command("threads_rounds")
	app:command("show_plan")
	app:command("plan_rounds")
	app:frames(30)
	expect(app:count("#plan-card")).to_be(1)
	expect(app:tree("#plan-card")).to_contain("Plan 2 · 4 steps")
	expect(app:tree("#plan-closed-1")).to_contain("Plan 1 · 1/3 · closed")
	expect(app:has("#plan-closed-1-steps")).to_be(false)
	expect(app:has("#card-h-old")).to_be(false)
	expect(app:has("#card-h-late")).to_be(false)
	expect(app:tree("#steps-started-d-old")).to_contain("Started step 1")
	expect(app:has("#delegate-d-old")).to_be(false)
	expect(plan_find(app, "old parser is ported")).to_be("No results")
	expect(plan_find(app, "parser pass too")).to_be("No results")
	app:click("#plan-closed-1-head")
	app:frames(30)
	expect(app:has("#plan-closed-1-step-c1")).to_be(true)
	expect(app:text("#plan-closed-1-step-c3-not-run")).to_be("Not run")
	expect(app:has("#plan-card-step-c3-not-run")).to_be(false)
	app:scroll("#fixture-plan >> #transcript", -200)
	app:frames(30)
	app:click("#plan-closed-1-step-c1-row")
	app:frames(30)
	local result = app:tree("#plan-closed-1-step-c1-result")
	expect(result).to_contain("The tests for the old parser pass too.")
	expect(result).never.to_contain("stepId")
	expect(result).never.to_contain("Plan 1, step")
	app:command("plan_forget_old")
	app:frames(30)
	expect(app:has("#plan-closed-1")).to_be(false)
	expect(app:tree("#card-h-old")).to_contain("The old parser is ported.")
	local late = app:tree("#card-h-late")
	expect(late).to_contain("Port the old parser · finished")
	expect(late).never.to_contain("stepId")
	expect(late).never.to_contain("Plan 1, step")
	expect(app:has("#delegate-d-old")).to_be(true)
	expect(app:has("#steps-started-d-old")).to_be(false)
	expect(app:count("#plan-card")).to_be(1)
	expect(app:error()).to_be(nil)
end)
