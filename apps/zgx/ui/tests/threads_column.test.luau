end)

local function editing(): any
	local app = seeded()
	app:click("#threads-plan-edit")
	app:frames(30)
	return app
end

test("threads: the plan bar heads the list; waiting, it says nothing has started and Approve approves", function()
	local app = seeded()
	expect(app:text("#threads-plan-progress")).to_be("0/3")
	expect(app:has("#threads-plan-waiting")).to_be(false)
	expect(app:has("#threads-plan-overview-text")).to_be(false)
	app:click("#threads-plan-overview")
	app:frames(20)
	expect(app:tree("#threads-plan-overview-text")).to_contain("Four changes")
	app:command("threads_pending")
	app:frames(20)
	expect(app:tree("#threads-plan-waiting")).to_contain("Waiting for your approval. Nothing has started.")
	expect(app:has("#threads-plan-overview-text")).to_be(true)
	app:click("#threads-plan-approve")
	app:frames(10)
	expect(calls(app)).to_contain("threads.approve::")
	expect(app:error()).to_be(nil)
end)

test("threads: a waiting row and its thread's banner read the pending question", function()
	local app = seeded()
	app:command("threads_ask")
	app:frames(20)
	expect(app:tree("#threads-row-owned-dg-ask")).to_contain("Redis or in memory for the counts?")
	app:click("#threads-row-owned-dg-ask")
	app:frames(30)
	expect(app:tree("#threads-waiting-banner")).to_contain("Waiting on you: Redis or in memory for the counts?")
	expect(app:tree("#threads-thread")).to_contain("\"Message this thread…\"")
	expect(app:error()).to_be(nil)
end)

test("threads: the editor saves only what changed in one threads.edit, with no images and the started steps first", function()
	local app = editing()
	expect(app:has("#threads-edit")).to_be(true)
	expect(tabs(app)[1].editing).to_be(true)
	expect(app:text("#threads-edit-count")).to_be("No changes yet")
	app:fill('role:textbox "Title of step 3"', "Write the changelog")
	app:frames(10)
	expect(app:text("#threads-edit-count")).to_be("1 change")
	app:drag("#threads-edit-grip-s6", "#threads-edit-step-s5")
	app:frames(20)
	expect(app:text("#threads-edit-count")).to_be("2 changes")
	app:click("#threads-edit-spec-s1")
	app:frames(20)
	expect(app:has("#threads-edit-locked-s1")).to_be(true)
	app:fill('role:textbox "Spec of step 1"', "Export orders as CSV and XLSX")
	app:click("#threads-edit-add")
	app:frames(20)
	app:fill('role:textbox "Title of step 5"', "Tag the release")
	app:frames(10)
	expect(app:text("#threads-edit-count")).to_be("4 changes")
	app:click("#threads-edit-save")
	app:frames(30)
	local args = app:state("threads_edit_args") :: any
	expect(args.chat).to_be("chat-1")
	expect(args.overview).to_be(nil)
	expect(args.overview_images).to_be(nil)
	expect(table.concat(args.order, ",")).to_be("s1,s2,s6,s5")
	expect(#args.remove).to_be(0)
	expect(#args.steps).to_be(3)
	expect(args.steps[1].id).to_be("s1")
	expect(args.steps[1].spec).to_be("Export orders as CSV and XLSX")
	expect(args.steps[1].title).to_be("Add CSV export to orders")
	expect(args.steps[2].id).to_be("s5")
	expect(args.steps[2].title).to_be("Write the changelog")
	expect(args.steps[2].role).to_be("general")
	expect(args.steps[3].id).to_be(nil)
	expect(args.steps[3].title).to_be("Tag the release")
	expect(args.steps[3].role).to_be("worker")
	for _, s in args.steps do
		expect(s.images).to_be(nil)
	end
	expect(app:has("#threads-list")).to_be(true)
	expect(tabs(app)[1].editing).to_be(nil)
	expect(app:error()).to_be(nil)
end)

test("threads: a started step has no grip or remove and nothing moves above it; leaving with changes asks first", function()
	local app = editing()
	for _, id in { "s1", "s2" } do
		expect(app:has(`#threads-edit-grip-{id}`)).to_be(false)
		expect(app:has(`#threads-edit-remove-{id}`)).to_be(false)
	end
	expect(app:has("#threads-edit-grip-s5")).to_be(true)
	app:drag("#threads-edit-grip-s5", "#threads-edit-step-s2")
	app:frames(20)
	expect(app:text("#threads-edit-count")).to_be("No changes yet")
	app:click("#threads-edit-remove-s6")
	app:frames(20)
	expect(app:has("#threads-edit-step-s6")).to_be(false)
	expect(app:text("#threads-edit-count")).to_be("1 change")
	app:click("#threads-edit-back")
	app:frames(20)
	expect(app:text("#threads-edit-discard-ask")).to_be("Discard 1 change?")
	app:click("#threads-edit-keep")
	app:frames(20)
	expect(app:text("#threads-edit-count")).to_be("1 change")
	app:click("#threads-edit-cancel")
	app:frames(20)
	app:click("#threads-edit-discard")
	app:frames(30)
	expect(app:has("#threads-list")).to_be(true)
	expect(calls(app)).never.to_contain("threads.edit")
	expect(app:error()).to_be(nil)
end)

test("threads: a refused save keeps the editor open with the edits", function()
	local app = editing()
	app:command("threads_refuse")
	app:fill('role:textbox "Title of step 3"', "Write the changelog")
	app:frames(10)
	app:click("#threads-edit-save")
	app:frames(30)
	expect(calls(app)).to_contain("threads.edit")
	expect(app:has("#threads-edit")).to_be(true)
	expect(app:text("#threads-edit-count")).to_be("1 change")
	expect(app:error()).to_be(nil)
end)

test("threads: the newest plan write carries the plan card; Approve and run while it waits, Approved after, Edit plan opens the editor", function()
	local app = seeded()
	app:command("show_plan")
	app:frames(30)
	expect(app:count("#plan-card")).to_be(1)
	expect(app:tree("#plan-card")).to_contain("Plan · 4 steps")
	expect(app:tree("#plan-card")).to_contain("Four changes")
	expect(app:tree("#plan-card")).to_contain("Write the release notes")
	expect(app:has("#plan-card-approved")).to_be(true)
	expect(app:has("#plan-card-approve")).to_be(false)
	expect(app:tree("#fixture-plan")).to_contain("Read 1 file")
	app:command("threads_pending")
	app:frames(20)
	expect(app:has("#plan-card-approved")).to_be(false)
	app:click("#plan-card-approve")
	app:frames(10)
	expect(calls(app)).to_contain("threads.approve::")
	app:click("#plan-card-edit")
	app:frames(30)
	expect(tabs(app)[1].editing).to_be(true)
	expect(app:has("#threads-edit")).to_be(true)
	expect(app:error()).to_be(nil)
end)
