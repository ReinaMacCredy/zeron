test("leaving Inbox for a level gives that level, whatever the levels were", function()
	local app = open()
	app:set_state(`{K}shell_sidebar_organize`, { "project" })
	app:set_state(`{K}shell_sidebar_inbox`, true)
	app:frames(20)
	app:click('role:button "Sidebar view options"')
	app:frames(20)
	app:click('.view-submenu >> "Organize"')
	app:frames(20)
	app:click('"By project"')
	app:frames(20)
	expect(app:state(`{K}shell_sidebar_inbox`)).to_be(false)
	expect(table.concat(app:state(`{K}shell_sidebar_organize`) :: any, ",")).to_be("project")
end)

