test("the peek stays for the filter's panel, the keys and a press, and Escape hands the keyboard on", function()
	local app = open()
	app:set_state(`{K}shell_sidebar_show_project_filter`, true)
	app:frames(10)
	app:click('#titlebar >> role:button "Toggle sidebar"')
	app:frames(40)
	app:hover("#sidebar-peek-edge")
	app:wait(`{SIDE} >> "Search"`, { timeout_ms = 800 })
	app:frames(30)
	expect(app:state("shell_sidebar_peek")).to_be(true)
	app:click('role:button "Filter by project"')
	app:frames(20)
	expect(app:state("ds_menu_held")).to_be(1)
	expect(app:has('role:option ~"Atlas"')).to_be(true)
	app:hover('role:option ~"Atlas"')
	app:frames(30)
	expect(app:state("shell_sidebar_peek")).to_be(true)
	app:hover(`{SIDE} >> role:button "Search"`)
	app:frames(10)
	app:key("Escape")
	app:frames(20)
	expect(app:state("ds_menu_held")).to_be(0)
	local focus = app:state("chat_focus") :: number
	expect(app:state("shell_sidebar_peek")).to_be(true)
	app:key("Escape")
	app:frames(20)
	expect(app:state("shell_sidebar_peek")).to_be(false)
	expect(app:state("chat_focus")).to_be(focus + 1)
end)

test("a session's menu walks with Ctrl+N and Ctrl+P as with the arrows, as Zeron's menus do", function()
	local app = open()
	app:right_click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(20)
	local function focused(): string?
		for line in app:tree():gmatch("[^\n]+") do
			if line:find(" menuitem ", 1, true) and line:find(" focused", 1, true) then
				return line:match('menuitem "([^"]+)"')
			end
		end
		return nil
	end
	app:key("ctrl+n")
	app:key("ctrl+n")
	app:frames(3)
	expect(focused()).to_be("Pin")
	app:key("ctrl+p")
	app:frames(3)
	expect(focused()).to_be("Rename")
	app:key("ArrowDown")
	app:frames(3)
	expect(focused()).to_be("Pin")
end)
