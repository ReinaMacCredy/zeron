test("a held draft's row stays, selected and frozen, as it's opened", function()
	local app = open()
	app:set_state("chat.composer.text", "held draft words")
	app:frames(5)
	app:set_state("shell_selected", "a1")
	app:frames(30)
	app:click("#sidebar-draft")
	app:frames(30)
	expect(app:has("#sidebar-draft")).to_be(true)
	expect(has_row(app, "Drafts")).to_be(true)
	app:set_state("chat.composer.text", "typed on")
	app:frames(10)
	expect(app:tree("#sidebar-draft")).to_contain("held draft words")
	app:hover("#sidebar-draft")
	app:frames(10)
	app:click('#sidebar-draft >> role:button "Discard draft"')
	app:frames(30)
	expect(app:has("#sidebar-draft")).to_be(false)
	expect(app:state("chat.composer.text")).to_be("")
end)

