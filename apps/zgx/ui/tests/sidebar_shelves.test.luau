-- The sidebar's Inbox shelves, Drafts row, hover peek, a rename reaching a row
-- folded away, and what it says when a place can't be taken. On the shell in
-- ui/shell_fixture.luau.

local SIDE = "#shell-sidebar"
local K = "screens/shell/sidebar.luau::"

local function open(): any
	local app = mount("shell_fixture.luau")
	app:resize(1200, 900)
	app:set_state("zgx.window.active", true)
	app:frames(30)
	return app
end

local function has_row(app: any, label: string): boolean
	return app:tree(SIDE):find(` button "{label}"`, 1, true) ~= nil
end

test("Organize: Inbox lists working chats on their shelf, and a settled chat leaves for Settled", function()
	local app = open()
	app:set_state(`{K}shell_sidebar_inbox`, true)
	app:set_state(`{K}shell_sidebar_show_working`, true)
	app:frames(40)
	expect(has_row(app, "Inbox")).to_be(true)
	expect(has_row(app, "Working")).to_be(true)
	expect(has_row(app, "Atlas")).to_be(false)
	local function above(a: string, b: string): boolean
		local y = {}
		for line in app:tree(SIDE):gmatch("[^\n]+") do
			for _, label in { a, b } do
				if line:find(` button "{label}"`, 1, true) then
					y[label] = tonumber(line:match(" %-?%d+,(%-?%d+) ")) :: number
				end
			end
		end
		return y[a] < y[b]
	end
	app:click(`{SIDE} >> role:button "Working"`)
	app:frames(40)
	expect(above("Write the docs", "Working")).to_be(true)
	expect(above("Working", "Fix the build")).to_be(true)
	-- Its menu settles it: the host told, and it stands on Settled.
	app:right_click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(20)
	app:click('role:menuitem "Settle"')
	app:frames(30)
	expect(app:state("calls")).to_contain("settle:a2:true")
	expect(has_row(app, "Settled")).to_be(true)
	app:click(`{SIDE} >> role:button "Settled"`)
	app:frames(40)
	expect(above("Settled", "Write the docs")).to_be(true)
end)

test("the Working and Settled shelves start folded, the chat open staying listed", function()
	local app = open()
	app:set_state("shell_selected", "a1")
	app:set_state(`{K}shell_sidebar_inbox`, true)
	app:set_state(`{K}shell_sidebar_show_working`, true)
	app:frames(40)
	expect(has_row(app, "Working")).to_be(true)
	expect(has_row(app, "Fix the build")).to_be(true)
	app:set_state("shell_selected", "a2")
	app:frames(40)
	expect(has_row(app, "Fix the build")).to_be(false)
end)

test("words held on a new chat stand under Drafts once you leave it, and Discard ends them", function()
	local app = open()
	app:set_state("chat.composer.text", "held draft words")
	app:frames(5)
	app:set_state("shell_selected", "a1")
	app:frames(30)
	expect(app:has("#sidebar-draft")).to_be(true)
	expect(has_row(app, "Drafts")).to_be(true)
	app:hover("#sidebar-draft")
	app:frames(10)
	app:click('#sidebar-draft >> role:button "Discard draft"')
	app:frames(30)
	expect(app:has("#sidebar-draft")).to_be(false)
	expect(has_row(app, "Drafts")).to_be(false)
end)

test("the pointer at the left edge floats a closed sidebar in, and leaving puts it away", function()
	local app = open()
	local function floating(): boolean
		return app:state("shell_sidebar_peek") == true
	end
	app:command("shell.toggle_sidebar")
	app:frames(40)
	app:hover("#sidebar-peek-edge")
	app:frames(2)
	expect(floating()).to_be(false)
	expect(app:wait("#sidebar-peek-panel", { timeout_ms = 2000 })).to_be(true)
	expect(floating()).to_be(true)
	app:frames(30)
	expect(has_row(app, "Write the docs")).to_be(true)
	app:hover("#chat-composer")
	expect(app:wait("#sidebar-peek-panel", { gone = true, timeout_ms = 2000 })).to_be(true)
	expect(floating()).to_be(false)
	-- Turned off in Settings: the edge is gone.
	app:set_state("screens/shell/view.luau::shell_sidebar_hover", false)
	app:frames(10)
	expect(app:tree("#sidebar-peek-edge")).to_contain("hidden")
end)

test("toggling the sidebar while it floats pins it where it stands", function()
	local app = open()
	app:command("shell.toggle_sidebar")
	app:frames(40)
	app:hover("#sidebar-peek-edge")
	app:wait("#sidebar-peek-panel", { timeout_ms = 2000 })
	app:frames(30)
	app:hover(`{SIDE} >> role:button "Write the docs"`)
	app:frames(5)
	app:command("shell.toggle_sidebar")
	app:frames(2)
	expect(app:state("shell_sidebar_peek_handoff")).to_be(true)
	app:frames(60)
	expect(app:state("screens/shell/view.luau::shell_collapsed")).to_be(false)
	expect(app:state("shell_sidebar_peek")).to_be(false)
	expect(app:state("shell_sidebar_peek_handoff")).to_be(false)
	expect(has_row(app, "Write the docs")).to_be(true)
end)

test("a rename opens what folds its row away", function()
	local app = open()
	app:set_state(`{K}shell_sidebar_organize`, { "project" })
	app:frames(30)
	app:click(`{SIDE} >> role:button "Atlas"`)
	app:frames(40)
	expect(has_row(app, "Tidy the tests")).to_be(false)
	app:set_state("shell_renaming_row", "a3")
	app:frames(40)
	expect(has_row(app, "Tidy the tests") or app:has(`{SIDE} >> role:textbox`)).to_be(true)
	expect(app:has(`{SIDE} >> role:textbox`)).to_be(true)
end)

test("a pin past two hundred says so and changes nothing", function()
	local app = open()
	local pinned = {}
	for i = 1, 200 do
		table.insert(pinned, `p{i}`)
	end
	local now = table.clone(app:state("sessions") :: any)
	now.places = { pinned = pinned, sections = {} }
	now.places_ready = true
	app:set_state("sessions", now)
	app:frames(20)
	app:right_click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(20)
	app:click('role:menuitem "Pin"')
	app:frames(20)
	expect(app:has('"You can pin up to 200 sessions"')).to_be(true)
	expect(tostring(app:state("calls") or "")).never.to_contain("place")
end)

test("a double click on the seam takes the width back to its default", function()
	local app = open()
	app:set_state("shell_sidebar_width", 300)
	app:frames(30)
	app:double_click('"Resize sidebar"')
	app:frames(30)
	-- (v0.3.2's default, screens/shell/fit_policy `SIDEBAR_DEFAULT`, a step wider than Zeron's 256.)
	expect(app:state("shell_sidebar_width")).to_be(272)
end)

test("Create Section asks for a name in a dialog; a section's menu edits it the same way", function()
	local app = open()
	app:click('role:button "Sidebar view options"')
	app:frames(20)
	app:click('role:menuitem "Create Section"')
	app:frames(20)
	expect(app:has('role:dialog "New section"')).to_be(true)
	app:click('role:dialog "New section" >> role:button "Create section"')
	app:frames(10)
	expect(app:has('role:dialog "New section"')).to_be(true)
	app:fill('role:dialog "New section" >> role:textbox', "Later")
	app:frames(10)
	app:click('role:dialog "New section" >> role:button "Create section"')
	app:frames(40)
	expect(has_row(app, "Later")).to_be(true)
	app:hover(`{SIDE} >> role:button "Later"`)
	app:frames(10)
	app:click(`{SIDE} >> role:button "Later" >> role:button "Section options"`)
	app:frames(20)
	app:click('role:menuitem "Edit section"')
	app:frames(20)
	app:fill('role:dialog "Edit section" >> role:textbox', "Someday")
	app:frames(5)
	app:click('role:dialog "Edit section" >> role:button "Save"')
	app:frames(30)
	expect(has_row(app, "Someday")).to_be(true)
	app:hover(`{SIDE} >> role:button "Someday"`)
	app:frames(10)
	app:click(`{SIDE} >> role:button "Someday" >> role:button "Section options"`)
	app:frames(20)
	app:key("ArrowDown")
	app:key("ArrowDown")
	app:frames(5)
	app:key("Enter")
	app:frames(30)
	expect(has_row(app, "Someday")).to_be(false)
end)

