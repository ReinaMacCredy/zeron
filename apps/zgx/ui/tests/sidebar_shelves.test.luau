test("a walk with the keys ends as the order changes", function()
	local app = open()
	app:set_state(`{K}shell_sidebar_compact`, true)
	app:frames(20)
	app:click(`{SIDE} >> role:button "Fix the build"`)
	app:frames(20)
	app:command("shell.next_session")
	app:frames(20)
	local before = app:state("shell_sidebar_order") :: any
	app:command("pin")
	app:frames(30)
	local now = app:state("shell_sidebar_order") :: any
	local here = string.match(tostring(app:state("shell_route_path")), "[^/]+$") :: string
	local stale = before[(table.find(before, here) :: number) % #before + 1]
	local live = now[(table.find(now, here) :: number) % #now + 1]
	expect(stale ~= live).to_be(true)
	app:command("shell.next_session")
	app:frames(20)
	expect(tostring(app:state("shell_route_path"))).to_contain(live)
end)

test("reordering inside a full Pinned is no new pin", function()
	local app = open()
	local pinned = { "a1", "a2" }
	for i = 3, 200 do
		table.insert(pinned, `p{i}`)
	end
	local now = table.clone(app:state("sessions") :: any)
	now.places = { pinned = pinned, sections = {} }
	now.places_ready = true
	app:set_state("sessions", now)
	app:frames(30)
	app:drag(`{SIDE} >> role:button "Write the docs"`, `{SIDE} >> role:button "Fix the build"`)
	app:frames(30)
	expect(app:has('"You can pin up to 200 sessions"')).to_be(false)
end)

test("a section can't be made while the places can't be written", function()
