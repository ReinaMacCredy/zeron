test("Reduce motion: System follows the computer, On and Off don't", function()
	local app = appearance()
	-- (Taller: with upstream's Accent colour row the page's middle, where app:scroll wheels, falls below an 800-tall window.)
	app:resize(1200, 2400)
	app:frames(20)
	expect(app:state("motion_follow_system")).to_be(true)
	expect(app:state("motion_reduce")).to_be(false)
	app:scroll(PAGE, 1200)
	app:frames(6)
	app:click(`{PAGE} >> role:button "Reduce motion"`)
	app:frames(20)
	app:click('role:menuitem "Off"')
	app:frames(20)
	expect(app:state("motion_follow_system")).to_be(false)
	expect(app:state("motion_reduce")).to_be(false)
	app:click(`{PAGE} >> role:button "Reduce motion"`)
	app:frames(20)
	app:click('role:menuitem "On"')
	app:frames(20)
	expect(app:state("motion_reduce")).to_be(true)
	expect(app:state("motion_follow_system")).to_be(false)
	expect(app:error()).to_be(nil)
end)

test("Glass: the select says it, and the palette's switch makes its own choice", function()
	local app = appearance()
	expect(app:state("surface")).to_be("frosted")
	app:set_state("surface", "opaque")
	app:frames(6)
	expect(app:state("frosted")).to_be(false)
	app:set_state("surface", "theme")
	app:frames(6)
	expect(app:state("frosted")).to_be(true)
	expect(app:state("surface")).to_be("theme")
	app:set_state("frosted", false)
	app:frames(6)
	expect(app:state("surface")).to_be("opaque")
	expect(app:error()).to_be(nil)
end)

test("Glass tint: dimming the desktop under a tint is one tint of more coverage, darker", function()
	-- Zeron's own numbers: 80% over 30% brightness is 94%, its colour by 0.8/0.94.
	local tuned = glass_tint.tuned("#646464cc", 0.8, 0.3) :: string
	expect(string.sub(tuned, 8, 9)).to_be(string.format("%02x", math.floor(0.94 * 255 + 0.5)))
	expect(string.sub(tuned, 2, 3)).to_be(string.format("%02x", math.floor(100 * 0.8 / 0.94 + 0.5)))
	expect(glass_tint.tuned("#646464cc", 0.6)).to_be(string.format("#646464%02x", math.floor(0.6 * 255 + 0.5)))
end)

test("Match wallpaper colors: the picture's colour is the accent, the helper says so, and off it's the theme's again", function()
	local app = appearance()
	with_art(app)
	app:set_state("shell_wallpaper_color", "#3366cc")
	app:set_state("wallpaper_theme_colors", true)
	app:frames(10)
	app:command("settings_stub.read_theme")
	app:frames(2)
	expect((app:state("settings_stub_window_theme") or {} :: any).accent ~= nil).to_be(true)
	expect(app:has(`{PAGE} >> "Wallpaper colors are enabled; this accent is used when they are off."`)).to_be(true)
	app:set_state("wallpaper_theme_colors", false)
	app:frames(10)
	expect(app:has(`{PAGE} >> "Wallpaper colors are enabled; this accent is used when they are off."`)).to_be(false)
	expect(app:error()).to_be(nil)
end)

