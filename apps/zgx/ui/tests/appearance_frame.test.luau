test("Adjust: Reset and the zoom's buttons move the draft; another picture chosen says so", function()
	local app = appearance()
	with_art(app)
	app:set_state("wallpaper_adjust_draft", { x = 0.5, y = 0.5, zoom = 1 })
	app:set_state("wallpaper_adjust_path", IMAGE.path)
	app:set_state("wallpaper_adjusting", true)
	app:frames(20)
	app:click(`role:button "Zoom in"`)
	app:frames(4)
	expect((app:state("wallpaper_adjust_draft") :: any).zoom).to_be(1.1)
	app:click(`role:button "Zoom out"`)
	app:frames(4)
	expect(math.abs((app:state("wallpaper_adjust_draft") :: any).zoom - 1) < 0.001).to_be(true)
	app:set_state("wallpaper_adjust_draft", { x = 0.1, y = 0.9, zoom = 2 })
	app:click(`#wallpaper-adjust-reset`)
	app:frames(4)
	local d = app:state("wallpaper_adjust_draft") :: any
	expect(d.x == 0.5 and d.y == 0.5 and d.zoom == 1).to_be(true)
	local real = { path = "assets/favicons/zeron.png", name = "zeron.png", w = 512, h = 512, x = 0.5, y = 0.5, zoom = 1 }
	app:set_state("shell_wallpaper_image", real)
	app:set_state("wallpaper_adjust_path", real.path)
	app:set_state("wallpaper_adjust_ready", "")
	app:frames(6)
	expect(app:has(`#wallpaper-adjust-state >> "Preparing preview…"`)).to_be(true)
	app:set_state("wallpaper_adjust_ready", real.path)
	app:frames(6)
	expect(app:has("#wallpaper-adjust-state")).to_be(false)
	app:set_state("shell_wallpaper_image", { path = "/other.png", name = "other.png", w = 512, h = 512, x = 0.5, y = 0.5, zoom = 1 })
	app:frames(10)
	expect(app:has(`#wallpaper-adjust-state >> "Background changed. Close and adjust the new image."`)).to_be(true)
	expect(app:error()).to_be(nil)
end)
