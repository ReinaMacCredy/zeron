
local shuffle_order = require("@ds/shuffle_order")
local glass_tint = require("@ds/glass_tint")

local PAGE = "#settings-page"
local NAV = "#settings-nav"
local IMAGE = { path = "/w0.png", name = "w0.png", w = 512, h = 512, x = 0.5, y = 0.5, zoom = 1 }

local function shell(): any
	local app = mount("shell_fixture.luau")
	app:resize(1200, 800)
	app:frames(30)
	app:command("settings_stub.sign_in")
	app:frames(10)
	return app
end

local function box(app: any, target: string): { x: number, y: number, width: number, height: number }
	local line = (app:tree(target) :: string):match("[^\n]+") or ""
	local x, y, w, h = line:match(" (%-?%d+),(%-?%d+) (%d+)x(%d+)")
	return { x = tonumber(x) or -1, y = tonumber(y) or -1, width = tonumber(w) or -1, height = tonumber(h) or -1 }
end

local function with_art(app: any)
	app:set_state("shell_wallpaper_image", IMAGE)
	app:set_state("shell_wallpaper", "image")
	app:frames(20)
end

local function appearance(): any
	local app = shell()
	app:command("shell.settings")
	app:frames(20)
	app:click(`{NAV} >> role:tab "Appearance"`)
	app:frames(30)
	app:scroll(PAGE, 3000)
	app:frames(6)
	app:click("#appearance-advanced")
	app:frames(20)
	return app
end

test("Shuffle's order: never a picture shown within the cooldown, and all of a small folder in reach", function()
	local six = { "a", "b", "c", "d", "e", "f" }
	local history: { string } = {}
	local seen: { string } = {}
	math.randomseed(7)
	for _ = 1, 40 do
		local pick = shuffle_order.order(six, history, math.random)[1]
		for back = 1, math.min(4, #seen) do
			expect(pick ~= seen[#seen + 1 - back]).to_be(true)
		end
		table.insert(seen, pick)
		history = shuffle_order.remember(history, pick)
	end
	local picks: { [string]: boolean } = {}
	for _ = 1, 50 do
		picks[shuffle_order.order(six, { "a", "b", "c", "d", "e", "f" }, math.random)[1]] = true
	end
	expect(picks.e and picks.f and not picks.a and not picks.d).to_be(true)
	expect(shuffle_order.order({ "a" }, { "a" }, math.random)[1]).to_be("a")
end)

test("Shuffle's history: the newest first, once, eight at most", function()
	local h: { string } = {}
	for i = 1, 10 do
		h = shuffle_order.remember(h, `p{i}`)
	end
	h = shuffle_order.remember(h, "p5")
	expect(#h).to_be(8)
	expect(h[1]).to_be("p5")
	expect(h[2]).to_be("p10")
	expect(table.find(h, "p5", 2)).to_be_nil()
end)

test("⌘U picks from the folder as Shuffle does, says so with none, and passes over a damaged picture", function()
	local app = shell()
	app:command("shell.random_wallpaper")
	app:frames(6)
	expect(app:state("shell_wallpaper_image")).to_be_nil()
	expect(app:state("wallpaper_problem")).to_be("settings.appearance.folder.first")
	app:set_state("shell_wallpaper_folder", "/art")
	local seen: { string } = {}
	for _ = 1, 12 do
		app:command("shell.random_wallpaper")
		app:frames(4)
		local source = app:state("shell_wallpaper_source") :: string
		for back = 1, math.min(4, #seen) do
			expect(source ~= seen[#seen + 1 - back]).to_be(true)
		end
		table.insert(seen, source)
	end
	expect(app:state("shell_wallpaper")).to_be("image")
	expect((app:state("shell_wallpaper_image") :: any).path).to_be(seen[#seen])
	expect(app:state("shell_wallpaper_color")).to_be("#3366cc")
	app:set_state("shell_wallpaper_folder", "/damaged")
	app:set_state("shell_wallpaper_history", { "/damaged/fine.png" })
	app:set_state("shell_wallpaper_source", "")
	app:command("shell.random_wallpaper")
	app:frames(4)
	expect(app:state("shell_wallpaper_source")).to_be("/damaged/fine.png")
	app:set_state("shell_wallpaper_folder", "/missing")
	app:command("shell.random_wallpaper")
	app:frames(4)
	expect(app:state("wallpaper_problem")).to_be("settings.appearance.folder.unreadable")
	expect(app:error()).to_be(nil)
end)

test("Choose folder keeps the dialog's folder, and Shuffle shows with one", function()
	local app = appearance()
	-- (Taller: with upstream's Accent colour row the page's middle, where app:scroll wheels, falls below an 800-tall window.)
	app:resize(1200, 2400)
	app:frames(20)
	expect(app:has(`{PAGE} >> role:button "Shuffle"`)).to_be(false)
	app:write_file("art-folder/a.png", "x")
	app:pick_folder("art-folder")
	app:scroll(PAGE, 1000)
	app:frames(6)
	app:click(`{PAGE} >> role:button "Choose folder"`)
	expect(app:wait(`{PAGE} >> role:button "Shuffle"`)).to_be(true)
	local folder = app:state("shell_wallpaper_folder") :: string
	expect(string.find(folder, "art-folder", 1, true) ~= nil).to_be(true)
	expect(string.sub(folder, 1, 1)).to_be("/")
	expect(app:error()).to_be(nil)
end)

test("The frame runs under the whole window with art on the page and nothing without it; the page's card starts at the bar's foot on every look", function()
	local app = shell()
	expect(app:has("#shell-frame")).to_be(false)
	expect(box(app, "#shell-page-card").y).to_be(42)
	with_art(app)
	local whole = box(app, "#shell-frame")
	expect(whole.width).to_be(1200)
	expect(whole.height).to_be(800)
	expect(app:has("#shell-frame-shade")).to_be(true)
	expect(app:has("#shell-frame-look")).to_be(false)
	expect(box(app, "#shell-page-card").y).to_be(42)
	app:set_state("shell_frame_blend", "fade")
	app:frames(10)
	local fading = box(app, "#shell-frame-look")
	local card = box(app, "#shell-page")
	expect(fading.x).to_be(0)
	expect(math.abs(fading.width - (card.x + 260)) < 2).to_be(true)
	app:set_state("shell_frame_style", "off")
	app:frames(20)
	expect(app:has("#shell-frame")).to_be(false)
	expect(box(app, "#shell-page-card").y).to_be(42)
	expect(math.abs(box(app, "#shell-page-card").x - card.x) < 2).to_be(true)
	app:set_state("inset_card", false)
	app:frames(40)
	expect(box(app, "#shell-page-card").y).to_be(42)
	expect(app:error()).to_be(nil)
end)

test("The art's hero is the window's 72%, 760 at most, from the window's top; a plugin's stays in its place", function()
	local app = shell()
	with_art(app)
	local hero = box(app, "#page-art")
	expect(hero.y).to_be(0)
	expect(hero.height).to_be(576)
	app:resize(1400, 1200)
	app:frames(20)
	expect(box(app, "#page-art").height).to_be(760)
	expect(box(app, "#page-art").x).to_be(0)
	app:set_state("shell_frame_style", "off")
	app:frames(20)
	expect(box(app, "#page-art").x).to_be(0)
	expect(app:error()).to_be(nil)
end)

test("A chat shows the art only with Chat background on, by its placement", function()
	local app = shell()
	with_art(app)
	app:click('#shell-sidebar >> role:button "Fix the build"')
	app:frames(30)
	expect(app:has("#shell-frame")).to_be(false)
	app:set_state("shell_chat_background", true)
	app:frames(20)
	expect(app:has("#shell-frame")).to_be(true)
	expect(app:has("#page-chat-art")).to_be(true)
	expect(app:has("#shell-page-card >> .art-scrim")).to_be(true)
	expect(box(app, "#shell-frame-art").height).to_be(576)
	app:set_state("shell_chat_background_placement", "full")
	app:frames(20)
	expect(box(app, "#shell-frame-art").height).to_be(800)
	app:set_state("shell_chat_background_scrim", false)
	app:frames(10)
	expect(app:has("#shell-page-card >> .art-scrim")).to_be(false)
	app:set_state("shell_wallpaper_image", nil)
	app:frames(20)
	expect(app:has("#shell-frame")).to_be(false)
	expect(app:error()).to_be(nil)
end)

