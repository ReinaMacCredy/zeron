local function open(): any
	local app = mount("bots_fixture.luau")
	app:resize(1200, 800)
	app:frames(30)
	app:click("#rail-bots")
	app:frames(30)
	return app
end
local function calls(app: any): string
	return app:state("bots_calls") :: string
end
local function pick(app: any, target: string, item: string)
	app:right_click(target)
	app:frames(20)
	app:click(`role:menuitem "{item}"`)
	app:frames(20)
end

test("Bots takes the sidebar: pinned tiles, the rest as rows, the archived one nowhere, the chats of Bots out of Home's list", function()
	local app = open()
	expect(app:has("#bots-panel")).to_be(true)
	local tree = app:tree("#bots-panel")
	expect(tree).to_contain('#bot-tile-k1 button "Release keeper"')
	expect(tree).to_contain('#bot-tile-k2 button "Docs writer"')
	expect(tree).to_contain('#bot-row-k3 button "Triage desk"')
	expect(tree).to_contain('#bot-row-k4 button "Nightly sweep"')
	expect(tree).never.to_contain("Old helper")
	expect(app:has("#bots-sessions")).to_be(false)
	app:click("#rail-new-chat")
	app:frames(30)
	expect(app:has("#bots-panel")).to_be(false)
	expect(app:tree("#shell-sidebar")).never.to_contain("Fix the build")
end)

test("a Bot opens its chat with the panel still there, read from then on; the Nth pinned one has a command", function()
	local app = open()
	app:click("#bot-row-k4")
	app:frames(30)
	expect(app:state("shell_route_path")).to_be("/session/a3")
	expect(app:has("#bots-panel")).to_be(true)
	expect(app:has("#bots-sessions-empty")).to_be(true)
	expect(app:has("#bots-needs")).to_be(false)
	expect(calls(app)).to_contain("update:k4:unread=false")
	app:command("bots.open_2")
	app:frames(30)
	expect(app:state("shell_route_path")).to_be("/session/a2")
end)

test("the menu pins and unpins in order, marks unread, archives, and deletes only once asked again", function()
	local app = open()
	pick(app, "#bot-row-k3", "Pin to top")
	expect(calls(app)).to_contain("update:k3:pinned=true")
	expect(app:has("#bot-tile-k3")).to_be(true)
	expect(app:has("#bot-row-k3")).to_be(false)
	pick(app, "#bot-tile-k1", "Unpin from top")
	expect(calls(app)).to_contain("update:k1:pinned=false")
	expect(app:has("#bot-row-k1")).to_be(true)
	pick(app, "#bot-row-k1", "Mark unread")
	expect(calls(app)).to_contain("update:k1:unread=true")
	pick(app, "#bot-row-k4", "Archive")
	expect(calls(app)).to_contain("update:k4:archived=true")
	expect(app:has("#bot-row-k4")).to_be(false)
	pick(app, "#bot-row-k1", "Delete")
	expect(calls(app)).never.to_contain("delete:k1")
	app:click('role:menuitem "Delete this Bot and its chat?"')
	app:frames(20)
	expect(calls(app)).to_contain("delete:k1")
	expect(app:has("#bot-row-k1")).to_be(false)
end)

test("Needs you shows for the open Bot alone and only with something to decide; its sessions are its chat's side chats, the panel staying as one opens", function()
	local app = open()
	app:click("#bot-row-k3")
	app:frames(30)
	expect(app:has("#bots-needs")).to_be(true)
	expect(app:tree("#bots-needs")).to_contain("#bot-decision-b1")
	app:command("side_chats")
	app:click("#bot-tile-k1")
	app:frames(30)
	expect(app:has("#bots-needs")).to_be(false)
	local tree = app:tree("#bots-sessions")
	expect(tree).to_contain('#bot-session-s1 button "Look into the flake"')
	expect(tree).to_contain('#bot-session-s2 button "Write the changelog"')
	app:click("#bot-session-s1")
	app:frames(30)
	expect(app:state("shell_route_path")).to_be("/session/s1")
	expect(app:has("#bots-panel")).to_be(true)
	expect(app:has("#bot-session-s2")).to_be(true)
end)

test("Escape closes the Properties menu, a submenu open or not", function()
	local app = open()
	app:click("#bot-tile-k1")
	app:frames(30)
	app:click("#bots-properties")
	app:frames(20)
	expect(app:tree("#bots-properties-sort")).never.to_contain("hidden")
	app:hover("#bots-properties-sort")
	app:frames(20)
	app:key("Escape")
	app:frames(20)
	expect(app:tree("#bots-properties-sort")).to_contain("hidden")
end)

test("with no Bots the panel says so", function()
	local app = open()
	app:command("fixture.bots_none")
	app:frames(20)
	expect(app:has("#bots-panel-empty")).to_be(true)
end)
