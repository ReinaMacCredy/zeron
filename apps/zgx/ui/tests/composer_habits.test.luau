-- The composer's habits from the keys and what the engine says, on
-- ui/chat_fixture.luau.

local function open(): any
	local app = mount("chat_fixture.luau")
	app:resize(1000, 700)
	app:command("go_s2")
	app:frames(30)
	return app
end

local function patch(app: any, fields: { [string]: any })
	app:set_state("test_patch", fields)
	app:command("patch_open")
	app:frames(10)
end

local function focused_field(app: any): boolean
	return (string.find(app:tree("#chat-composer"), 'textbox "Message"[^\n]* focused')) ~= nil
end

local function draft(app: any): string
	return app:state("chat.composer.text")
end

test("Shift+Tab in the draft flips plan, not the window's focus", function()
	local app = open()
	app:click("role:textbox")
	app:frames(5)
	expect(app:tree("#composer-plan")).to_contain("unchecked")
	app:key("shift+Tab")
	app:frames(30)
	expect(app:tree("#composer-plan")).never.to_contain("unchecked")
	expect(focused_field(app)).to_be(true)
	app:key("shift+Tab")
	app:frames(30)
	expect(app:tree("#composer-plan")).to_contain("unchecked")
end)

test("a prediction shows on an empty draft and after what it starts with, and Tab takes it", function()
	local app = open()
	patch(app, { prediction = "run the tests" })
	app:type("role:textbox", "run")
	app:frames(10)
	expect(app:has("#composer-ghost")).to_be(true)
	app:key("Tab")
	app:frames(10)
	expect(draft(app)).to_be("run the tests")
end)

test("a draft the prediction doesn't start with shows none, and Tab leaves it", function()
	local app = open()
	patch(app, { prediction = "run the tests" })
	app:type("role:textbox", "fix")
	app:frames(10)
	expect(app:has("#composer-ghost")).to_be(false)
	app:key("Tab")
	app:frames(10)
	expect(draft(app)).to_be("fix")
end)

test("a stopped turn offers Resume with an empty draft, and it sends the words Zeron's does", function()
	local app = open()
	expect(app:has("#composer-resume")).to_be(false)
	patch(app, { stopped = true })
	app:frames(20)
	expect(app:has("#composer-resume")).to_be(true)
	app:click("#composer-resume")
	app:frames(10)
	expect(app:state("calls")).to_contain("send:s2:Resume without asking to continue.")
end)

test("words typed over a stopped turn take Resume's place", function()
	local app = open()
	patch(app, { stopped = true })
	app:type("role:textbox", "go on")
	app:frames(20)
	expect(app:tree("#chat-composer")).never.to_contain('"Resume"')
end)

test("a limit says who and when, and waiting says something else", function()
	local app = open()
	patch(app, { limit = { resets_at = (os.time() + 3600) * 1000, auto = false, to = false } })
	local words = app:tree("#chat-composer")
	expect(words).to_contain("limit reached")
	expect(words).to_contain("Resets at")
	expect(words).to_contain("Wait for reset")
	expect(words).to_contain("Switch model")
	patch(app, { limit = { resets_at = (os.time() + 3600) * 1000, auto = true, to = false } })
	words = app:tree("#chat-composer")
	expect(words).to_contain("Waiting for the")
	expect(words).to_contain("Cancel")
	expect(words).never.to_contain("Switch model")
end)

test("a reset already past reads as not known", function()
	local app = open()
	patch(app, { limit = { resets_at = (os.time() - 60) * 1000, auto = true, to = false } })
	local words = app:tree("#chat-composer")
	expect(words).to_contain("Reset time unknown")
	expect(words).never.to_contain("Wait for reset")
end)

test("a word that only starts like a command, or an indented one, goes to the agent", function()
	local app = open()
	app:type("role:textbox", "/compaction is broken")
	app:key("Enter")
	app:frames(10)
	expect(app:state("calls")).to_contain("send:s2:/compaction is broken")
	app:type("role:textbox", "    /compact")
	app:key("Escape")
	app:key("Enter")
	app:frames(10)
	expect(app:state("calls")).to_contain("send:s2:    /compact")
	app:type("role:textbox", "/btwn")
	app:key("Enter")
	app:frames(10)
	expect(app:state("calls")).to_contain("send:s2:/btwn")
end)

test("Resume sends its words over a stray space in the draft", function()
	local app = open()
	patch(app, { stopped = true })
	app:set_state("chat.composer.text", "  ")
	app:frames(20)
	app:click("#composer-resume")
	app:frames(10)
	expect(app:state("calls")).to_contain("send:s2:Resume without asking to continue.")
	expect(app:state("calls")).never.to_contain("send:s2:  ")
end)

test("a pick is the only thing that moves a chat, and the row it's on already moves nothing", function()
	local app = open()
	patch(app, { branch = "main" })
	app:click("#composer-session-branch")
	app:frames(20)
	app:click('role:option "main main checkout"')
	app:frames(10)
	expect(app:state("calls")).never.to_contain("move:")
	patch(app, { branch = "elsewhere" })
	app:command("go_s1")
	app:frames(30)
	app:command("go_s2")
	app:frames(30)
	expect(app:state("calls")).never.to_contain("move:")
	app:click("#composer-session-branch")
	app:frames(20)
	app:click('role:option "fix/render-loop render-loop"')
	app:frames(10)
	expect(app:state("calls")).to_contain("move:s2:")
end)

test("a branch with no worktree says so under its list, which stays open, and moves nothing", function()
	local app = open()
	patch(app, { branch = "main" })
	app:click("#composer-session-branch")
	app:frames(20)
	app:click('role:option "release/2.4"')
	app:frames(10)
	app:frames(60)
	expect(app:has('"No worktree for release/2.4"')).to_be(true)
	expect(string.find(string.match(app:tree('role:option "release/2.4"'), "[^\n]+") or " hidden", " hidden", 1, true)).to_be_nil()
	expect(app:state("calls")).never.to_contain("move:")
end)

test("a short draft folds back to one line where the chips' words have folded", function()
	local app = mount("chat_fixture.luau")
	app:resize(700, 700)
	app:command("go_s2")
	app:frames(40)
	local function height(): number
		local line = string.match(app:tree('#chat-composer >> role:textbox "Message"'), "[^\n]+") or ""
		return tonumber(string.match(line, " %-?%d+,%-?%d+ %d+x(%d+)")) or -1
	end
	expect(height()).to_be(22)
	app:set_state("chat.composer.text", string.rep("a long draft ", 20))
	app:frames(40)
	expect(height() > 22).to_be(true)
	app:set_state("chat.composer.text", "a draft nearly the line's own width")
	app:frames(40)
	expect(height()).to_be(22)
	-- Too narrow to leave the draft its room: opened out with nothing written.
	app:set_state("chat.composer.text", "")
	app:resize(480, 700)
	app:frames(40)
	expect(height() > 22).to_be(true)
end)

test("with no project chosen / and @ resolve and /model takes no turn", function()
	local app = mount("chat_fixture.luau")
	app:resize(1000, 700)
	app:frames(30)
	app:command("go_home")
	app:frames(60)
	app:set_state("screens/chat/composer.luau::chat_project", "none")
	app:set_state("screens/shell/route.luau::shell_project", nil)
	app:frames(20)
	app:type("role:textbox", "@")
	app:frames(30)
	expect(app:has(".mention-skeleton")).to_be(false)
	app:set_state("chat.composer.text", "/mo")
	app:frames(30)
	expect(app:has('role:option "/model"')).to_be(true)
	app:set_state("chat.composer.text", "/model")
	app:frames(10)
	app:key("Enter")
	app:frames(10)
	expect(app:state("calls")).never.to_contain("send:")
	expect(app:error()).to_be_nil()
end)

test("a new chat with nowhere to start keeps its draft and chips", function()
	local app = mount("chat_fixture.luau")
	app:resize(1000, 700)
	app:frames(30)
	app:command("go_home")
	app:frames(60)
	app:set_state("screens/chat/composer.luau::chat_project", "gone-project")
	app:set_state("chat.composer.text", "a new chat's words")
	app:set_state("chat.composer.cargo", { { id = "f1", kind = "file", name = "a.txt", path = "/x/a.txt", number = 1 } })
	app:frames(20)
	app:click("role:textbox")
	app:key("Enter")
	app:frames(20)
	expect(app:state("calls")).never.to_contain("made:")
	expect(draft(app)).to_be("a new chat's words")
	expect(#app:state("chat.composer.cargo")).to_be(1)
end)

test("a file over the limit on another device is refused with its name, and the draft stays", function()
	local app = open()
	patch(app, { device = "another-device" })
	app:set_state("chat.composer.text", "with a big file")
	app:set_state("chat.composer.cargo", { { id = "big", kind = "file", name = "clip.mp4", path = "/x/clip.mp4", on_host = true, linked = true, number = 1 } })
	app:frames(10)
	app:click("role:textbox")
	app:key("Enter")
	app:frames(10)
	expect(app:state("calls")).never.to_contain("send:s2")
	expect(draft(app)).to_be("with a big file")
	expect(#app:state("chat.composer.cargo")).to_be(1)
	expect(app:tree("#chat-composer")).to_contain("clip.mp4 is too large to send to another device")
end)

test("out of Cloud credits a send keeps the draft", function()
	local app = open()
	app:command("cloud_stub.offer")
	app:frames(30)
	local now = table.clone(app:state("account/cloud.luau::account_cloud"))
	local status = table.clone(now.status)
	status.credits = 0
	now.status = status
	app:set_state("account/cloud.luau::account_cloud", now)
	patch(app, { device = status.device_id or status.device })
	app:set_state("chat.composer.text", "a paragraph")
	app:frames(10)
	app:click("role:textbox")
	app:key("Enter")
	app:frames(10)
	expect(app:state("calls")).never.to_contain("send:s2")
	expect(draft(app)).to_be("a paragraph")
end)

test("a refusal goes by a click on it", function()
	local app = open()
	app:set_state("chat.composer.refused", "dir is not a file.")
	app:frames(20)
	app:click('"dir is not a file."')
	app:frames(5)
	expect(app:state("chat.composer.refused")).to_be_nil()
end)

test("/btw and /compact take no turn of this chat", function()
	local app = open()
	app:type("role:textbox", "/compact the plan")
	app:key("Enter")
	app:frames(10)
	expect(app:state("calls")).never.to_contain("send:s2")
	expect(draft(app)).to_be("")
	app:type("role:textbox", "/btw what is this")
	app:key("Enter")
	app:frames(10)
	expect(app:state("calls")).never.to_contain("send:s2")
	expect(draft(app)).to_be("")
end)

test("with Steer as the setting a running chat's message steers, and Cmd+Enter queues it", function()
	local app = open()
	app:set_state("screens/settings/prefs.luau::settings_follow_up", "steer")
	patch(app, { running = true })
	app:type("role:textbox", "one")
	app:key("Enter")
	app:frames(10)
	expect(app:state("calls")).to_contain("send:s2:one")
	expect(app:state("calls")).to_contain("send:s2:one|steer_now")
	app:type("role:textbox", "two")
	app:key("cmd+Enter")
	app:frames(10)
	expect(app:state("calls")).to_contain("send:s2:two")
	expect(app:state("calls")).never.to_contain("send:s2:two|steer_now")
end)

test("a fence's lines take its language's colours, on the wash", function()
	local app = open()
	app:command("fence_probe")
	app:frames(2)
	local said = app:state("test_fence")
	expect(said).to_contain("$zeron.syntax.keyword")
	expect(said).to_contain("wash:yes")
	expect(said).never.to_contain("wash:no")
	expect(said).to_contain("closed:0")
	expect(said).to_contain("unknown:1")
end)
