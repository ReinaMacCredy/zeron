{
  "name": "mock-question",
  "steps": [
    { "name": "dismiss the Appshots welcome", "ui": "click", "select": "Button \"Not now\"" },
    { "engine": "LocalDevice", "save": "device" },
    { "engine": "Mutate", "params": { "op": "createSpace", "spaceId": "5ce7a000-0000-4000-8000-000000000001", "deviceId": "${device.deviceId}", "path": "${env.ZERON_SCENARIO_PROJECT}" } },
    { "engine": "Mutate", "params": { "op": "createChat", "chatId": "c4a70000-0000-4000-8000-000000000001", "spaceId": "5ce7a000-0000-4000-8000-000000000001", "config": { "harness": "mock", "model": "fable-5", "reasoning": null, "sandbox": "workspace-write" } } },
    { "engine": "Mutate", "params": { "op": "renameChat", "chatId": "c4a70000-0000-4000-8000-000000000001", "title": "Scenario pick a color" } },
    { "name": "go to New chat from the palette", "ui": "key", "keys": "cmd-k" },
    { "assert": { "select": "Dialog \"Command palette\"" } },
    { "ui": "wait", "for": "idle" },
    { "ui": "click", "select": "ListBoxOption \"New chat\"" },
    { "assert": { "select": "Dialog \"Command palette\"", "exists": false } },
    { "ui": "state", "save": "home" },
    { "assert": { "saved": "home.route.kind", "equals": "newChat" } },
    { "name": "open the chat from its sidebar row", "ui": "click", "select": "Button \"Scenario pick a color\"" },
    { "ui": "wait", "for": "idle" },
    { "ui": "state", "save": "opened" },
    { "assert": { "saved": "opened.route.selectedChat", "equals": "c4a70000-0000-4000-8000-000000000001" } },
    { "assert": { "select": "Tab \"Scenario pick a color\"" } },
    { "snapshot": "before" },
    { "name": "send the prompt from the composer", "ui": "type", "select": "MultilineTextInput \"Do anything\"", "text": "Pick an accent color for the demo" },
    { "ui": "key", "keys": "enter" },
    { "name": "the question card asks", "assert": { "select": "RadioButton \"Green\"", "timeoutMs": 10000 } },
    { "assert": { "select": "RadioGroup \"Which accent color should the demo use?\"" } },
    { "assert": { "select": "Button \"Submit\"" } },
    { "name": "the transcript shows the prompt and the tool group", "assert": { "text": "You: Pick an accent color for the demo" } },
    { "assert": { "select": "Button \"Ran 1 command\"" } },
    { "assert": { "text": "Question: Awaiting your answer" } },
    { "ui": "wait", "for": "idle" },
    { "snapshot": "question" },
    { "name": "answer Green by clicking it (single select submits on its own)", "ui": "click", "select": "RadioButton \"Green\"" },
    { "name": "the question card closes", "assert": { "select": "RadioButton \"Green\"", "exists": false } },
    { "ui": "wait", "for": "idle", "timeoutMs": 10000 },
    { "name": "the reply echoes the answer", "assert": { "text": "Picked: Green", "timeoutMs": 10000 } },
    { "assert": { "text": "Question: Accent" } },
    { "name": "expand the settled turn's Worked-for fold", "ui": "click", "select": "Button \"Worked for\"" },
    { "ui": "wait", "for": "idle" },
    { "name": "expand the tool group", "ui": "click", "select": "Button \"Ran 1 command\"" },
    { "assert": { "select": "Button \"Run ls palette\"" } },
    { "ui": "wait", "for": "idle" },
    { "snapshot": "after" }
  ]
}
