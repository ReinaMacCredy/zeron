{
  "name": "mock-question",
  "steps": [
    { "name": "dismiss the Appshots welcome", "ui": "key", "keys": "escape" },
    { "engine": "LocalDevice", "save": "device" },
    { "engine": "Mutate", "params": { "op": "createSpace", "spaceId": "5ce7a000-0000-4000-8000-000000000001", "deviceId": "${device.deviceId}", "path": "${env.ZERON_SCENARIO_PROJECT}" } },
    { "engine": "Mutate", "params": { "op": "createChat", "chatId": "c4a70000-0000-4000-8000-000000000001", "spaceId": "5ce7a000-0000-4000-8000-000000000001", "config": { "harness": "mock", "model": "fable-5", "reasoning": null, "sandbox": "workspace-write" } } },
    { "engine": "Mutate", "params": { "op": "renameChat", "chatId": "c4a70000-0000-4000-8000-000000000001", "title": "Scenario pick a color" } },
    { "name": "go to New chat from the palette", "ui": "key", "keys": "cmd-k" },
    { "ui": "wait", "for": "idle" },
    { "ui": "click", "select": "Button \"New chat\"" },
    { "ui": "state", "save": "home" },
    { "assert": { "saved": "home.route.kind", "equals": "newChat" } },
    { "name": "open the chat by its title from the palette", "ui": "key", "keys": "cmd-k" },
    { "ui": "wait", "for": "idle" },
    { "ui": "type", "select": "MultilineTextInput \"Search threads\"", "text": "Scenario pick a color" },
    { "ui": "wait", "for": "idle" },
    { "ui": "key", "keys": "enter" },
    { "ui": "state", "save": "opened" },
    { "assert": { "saved": "opened.route.selectedChat", "equals": "c4a70000-0000-4000-8000-000000000001" } },
    { "ui": "wait", "for": "idle" },
    { "snapshot": "before" },
    { "name": "send the prompt from the composer", "ui": "type", "select": "MultilineTextInput \"Do anything\"", "text": "Pick an accent color for the demo" },
    { "ui": "key", "keys": "enter" },
    { "name": "the question card asks", "assert": { "select": "MultilineTextInput \"Type your own answer\"", "timeoutMs": 10000 } },
    { "ui": "wait", "for": "idle" },
    { "snapshot": "question" },
    { "name": "answer Green with its 2 shortcut", "ui": "key", "keys": "2" },
    { "name": "the question card closes", "assert": { "select": "MultilineTextInput \"Type your own answer\"", "exists": false } },
    { "ui": "wait", "for": "idle", "timeoutMs": 10000 },
    { "name": "read the transcript", "engine": "WatchDocMessages", "params": { "chatId": "c4a70000-0000-4000-8000-000000000001" }, "first": true, "save": "doc" },
    { "assert": { "saved": "doc.reset.0.parts.0.text", "equals": "Pick an accent color for the demo" } },
    { "assert": { "saved": "doc.reset.1.status", "equals": "complete" } },
    { "assert": { "saved": "doc.reset.1.parts", "contains": "\"command\":\"ls palette\"" } },
    { "assert": { "saved": "doc.reset.1.parts", "contains": "\"labels\":[\"Green\"]" } },
    { "assert": { "saved": "doc.reset.1.parts", "contains": "Picked: Green" } },
    { "snapshot": "after" }
  ]
}
