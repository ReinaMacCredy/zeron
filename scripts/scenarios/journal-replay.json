{
  "name": "journal-replay",
  "steps": [
    { "name": "dismiss the Appshots welcome", "ui": "click", "select": "Button \"Not now\"" },
    { "engine": "LocalDevice", "save": "device" },
    { "engine": "Mutate", "params": { "op": "createSpace", "spaceId": "5ce7a000-0000-4000-8000-000000000002", "deviceId": "${device.deviceId}", "path": "${env.ZERON_SCENARIO_PROJECT}" } },
    { "engine": "Mutate", "params": { "op": "createChat", "chatId": "c4a70000-0000-4000-8000-000000000002", "spaceId": "5ce7a000-0000-4000-8000-000000000002", "config": { "harness": "mock", "model": "fable-5", "reasoning": null, "sandbox": "workspace-write" } } },
    { "engine": "Mutate", "params": { "op": "renameChat", "chatId": "c4a70000-0000-4000-8000-000000000002", "title": "Scenario journal replay" } },
    { "name": "go to New chat from the palette", "ui": "key", "keys": "cmd-k" },
    { "assert": { "select": "Dialog \"Command palette\"" } },
    { "ui": "wait", "for": "idle" },
    { "ui": "click", "select": "ListBoxOption \"New chat\"" },
    { "name": "open the chat from its sidebar row", "ui": "click", "select": "Button \"Scenario journal replay\"" },
    { "ui": "wait", "for": "idle" },
    { "ui": "state", "save": "opened" },
    { "assert": { "saved": "opened.route.selectedChat", "equals": "c4a70000-0000-4000-8000-000000000002" } },
    { "name": "send the prompt that plays the journal turn", "ui": "type", "select": "MultilineTextInput \"Do anything\"", "text": "Fix the widget count" },
    { "ui": "key", "keys": "enter" },
    { "name": "the reply lands", "assert": { "text": "the count now includes the last widget", "timeoutMs": 10000 } },
    { "ui": "wait", "for": "idle", "timeoutMs": 10000 },
    { "assert": { "text": "You: Fix the widget count" } },
    { "snapshot": "replayed" },
    { "name": "expand the Worked-for fold", "ui": "click", "select": "Button \"Worked for\"" },
    { "ui": "wait", "for": "idle" },
    { "name": "expand the reasoning group", "ui": "click", "select": "Button \"Thought process\"" },
    { "assert": { "text": "Plan: run the widget tests" } },
    { "assert": { "text": "Running the widget tests first." } },
    { "ui": "wait", "for": "idle" },
    { "name": "expand the tool group", "ui": "click", "select": "Button \"Ran 1 command\"" },
    { "assert": { "text": "cargo test -p demo-widgets" } },
    { "assert": { "text": "widgets.rs" } },
    { "assert": { "text": "Todo 0/2 done" } },
    { "ui": "wait", "for": "idle" },
    { "snapshot": "tool-chips" }
  ]
}
