{
  "name": "journal-replay",
  "steps": [
    { "name": "dismiss the Appshots welcome", "ui": "key", "keys": "escape" },
    { "engine": "LocalDevice", "save": "device" },
    { "engine": "Mutate", "params": { "op": "createSpace", "spaceId": "5ce7a000-0000-4000-8000-000000000002", "deviceId": "${device.deviceId}", "path": "${env.ZERON_SCENARIO_PROJECT}" } },
    { "engine": "Mutate", "params": { "op": "createChat", "chatId": "c4a70000-0000-4000-8000-000000000002", "spaceId": "5ce7a000-0000-4000-8000-000000000002", "config": { "harness": "mock", "model": "fable-5", "reasoning": null, "sandbox": "workspace-write" } } },
    { "engine": "Mutate", "params": { "op": "renameChat", "chatId": "c4a70000-0000-4000-8000-000000000002", "title": "Scenario journal replay" } },
    { "name": "go to New chat from the palette", "ui": "key", "keys": "cmd-k" },
    { "ui": "wait", "for": "idle" },
    { "ui": "click", "select": "Button \"New chat\"" },
    { "name": "open the chat by its title from the palette", "ui": "key", "keys": "cmd-k" },
    { "ui": "wait", "for": "idle" },
    { "ui": "type", "select": "MultilineTextInput \"Search threads\"", "text": "Scenario journal replay" },
    { "ui": "wait", "for": "idle" },
    { "ui": "key", "keys": "enter" },
    { "ui": "state", "save": "opened" },
    { "assert": { "saved": "opened.route.selectedChat", "equals": "c4a70000-0000-4000-8000-000000000002" } },
    { "name": "send the prompt that plays the journal turn", "ui": "type", "select": "MultilineTextInput \"Do anything\"", "text": "Fix the widget count" },
    { "ui": "key", "keys": "enter" },
    { "ui": "wait", "for": "idle", "timeoutMs": 10000 },
    { "name": "read the transcript", "engine": "WatchDocMessages", "params": { "chatId": "c4a70000-0000-4000-8000-000000000002" }, "first": true, "save": "doc" },
    { "assert": { "saved": "doc.reset.1.status", "equals": "complete" } },
    { "assert": { "saved": "doc.reset.1.parts", "contains": "Plan: run the widget tests" } },
    { "assert": { "saved": "doc.reset.1.parts", "contains": "\"command\":\"cargo test -p demo-widgets\"" } },
    { "assert": { "saved": "doc.reset.1.parts", "contains": "\"kind\":\"editFile\"" } },
    { "assert": { "saved": "doc.reset.1.parts", "contains": "\"path\":\"src/widgets.rs\"" } },
    { "assert": { "saved": "doc.reset.1.parts", "contains": "Fix the off-by-one in widget_count" } },
    { "assert": { "saved": "doc.reset.1.parts", "contains": "the count now includes the last widget" } },
    { "snapshot": "replayed" },
    { "name": "expand the Worked-for fold at its window point (no a11y node yet)", "ui": "click", "x": 470, "y": 173 },
    { "ui": "wait", "for": "idle" },
    { "name": "expand the tool group at its window point (no a11y node yet)", "ui": "click", "x": 560, "y": 283 },
    { "ui": "wait", "for": "idle" },
    { "snapshot": "tool-chips" }
  ]
}
